# 构建产物
**/bin/
**/obj/
*.user
*.suo
.vs/

# 运行时数据（数据库/附件/日志/归档一律在 %LOCALAPPDATA%\Sinan，不入库）
*.db
*.db-wal
*.db-shm
logs/
attachments/
archive/

# 本机真实资料（仅用于本地自测，禁止入库）
source/
data/
.sensitive.local

# 系统与工具临时文件
Thumbs.db
desktop.ini
.DS_Store

# UI 目检临时截图（ui_smoke --shots 产物，需要时重新生成）
docs/_build/shots_current/

# CodeGraph 本机索引（每台机器自建，22MB 数据库不入库）
.codegraph/
