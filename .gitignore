# 构建产物
**/bin/
**/obj/
*.user
*.suo
.vs/

# 运行时数据（数据库/附件/日志/归档一律在 %LOCALAPPDATA%\Sinan，不入库）
*.db
*.db-wal
*.db-shm
logs/
attachments/
archive/

# 本机真实资料（仅用于本地自测，禁止入库）
# 注意：必须锚定根目录，否则会误伤 `mobile/lib/data/` 源码目录。
/source/
/data/
.sensitive.local

# 系统与工具临时文件
Thumbs.db
desktop.ini
.DS_Store

# Python 工具缓存（tools/ 下的辅助脚本）
__pycache__/
*.pyc

# UI 目检临时截图（ui_smoke --shots 产物，需要时重新生成）
docs/_build/shots_current/

# CodeGraph 本机索引（每台机器自建，22MB 数据库不入库）
.codegraph/

# 手机端 E2E 失败产物（截图 + UI 树，需要时重新跑用例生成）
tools/mobile_e2e/artifacts/
