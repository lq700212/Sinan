<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF 桌面端：MVVM 分层，View 不直连数据库。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Sinan.App</RootNamespace>
    <AssemblyName>Sinan</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- exe 内嵌图标：资源管理器 / 桌面快捷方式 / 任务栏固定项读这里（docs/branding/logo-2-ladle.svg 转换）。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel 来自 .NET 共享框架（随运行时安装），不是 NuGet 包：
         用普通 socket 监听 5180，非管理员也能绑定局域网 IP，不需要 netsh urlacl。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sinan.Core\Sinan.Core.csproj" />
    <ProjectReference Include="..\Sinan.Data\Sinan.Data.csproj" />
    <!-- 公司级 WPF 复用库（git submodule）；只引 UI 工程，主库 Kaleidoscope 是 net472 通讯库，司南不引。 -->
    <ProjectReference Include="..\..\ThirdParty\Kaleidoscope\Kaleidoscope.UI\Kaleidoscope.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行窗口图标（任务栏运行态 / Alt-Tab / 窗口标题栏）：ApplicationIcon 只嵌 exe 资源，
         不会自动成为 WPF Resource，缺这一行 Window.Icon 运行时会加载失败。 -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
</Project>
