<UserControl x:Class="Sinan.App.Views.ExchangePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}">

    <!--
      ============================================================================
      数据交换（设计稿 p3 import / p4 export）
      左：导入四步向导（选择文件 → 列映射 → 校验预览 → 确认导入）
      右：导出（范围 + 版式三选一 + 选项 + 结果）
      纪律：预览不写库；原表永不被修改；导出统一落 archive\exports 不弹保存框。
      ============================================================================
    -->

    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶部状态条 ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,13">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="数据交换" Style="{StaticResource T.H2}" FontSize="16"/>
                    <TextBlock Text="·" Style="{StaticResource T.Tiny}" Margin="8,0"/>
                    <TextBlock Text="Excel 原表双向通道" Style="{StaticResource T.Small}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastImportDisplay, StringFormat=最近导入：{0}}"
                               Style="{StaticResource T.Tiny}" FontSize="10"/>
                    <Button Content="打开数据目录" Style="{StaticResource Btn.Ghost}" Height="26"
                            Padding="0" FontSize="10.5" Margin="12,0,0,0"
                            AutomationProperties.AutomationId="OpenDataFolderButton"
                            Command="{Binding OpenDataFolderCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 提示条 ==================== -->
        <StackPanel Grid.Row="1">
            <Border Padding="12,9" CornerRadius="10" Margin="0,10,0,0"
                    Background="{DynamicResource Brush.NgSoft}"
                    BorderBrush="{DynamicResource Brush.NgLine}" BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource TrueToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           FontSize="{DynamicResource Text.Size.Small}"
                           Foreground="{DynamicResource Brush.Ng}"/>
            </Border>
            <Border Padding="12,9" CornerRadius="10" Margin="0,10,0,0"
                    Background="{DynamicResource Brush.OkSoft}"
                    BorderBrush="{DynamicResource Brush.OkLine}" BorderThickness="1"
                    Visibility="{Binding HasNotice, Converter={StaticResource TrueToVisibility}}">
                <TextBlock Text="{Binding NoticeMessage}" TextWrapping="Wrap"
                           FontSize="{DynamicResource Text.Size.Small}"
                           Foreground="{DynamicResource Brush.Ok}"/>
            </Border>
        </StackPanel>

        <!-- ==================== 主体两栏 ==================== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左：导入四步向导 ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,15" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 + 步骤条 -->
                    <StackPanel Grid.Row="0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="导入 Excel 原表" Style="{StaticResource T.H2}" FontSize="15"/>
                                <ContentControl Style="{StaticResource Chip}" Tag="warn" Margin="8,0,0,0">
                                    <TextBlock Text="预览不写库" FontSize="9.5"/>
                                </ContentControl>
                            </StackPanel>
                            <Button Content="选择文件并解析" Style="{StaticResource Btn.Secondary}" Height="30"
                                    HorizontalAlignment="Right" FontSize="11.5" Padding="12,0"
                                    AutomationProperties.AutomationId="PreviewButton"
                                    Command="{Binding PreviewCommand}"/>
                        </Grid>

                        <!-- 四步条：当前步高亮，已完成的步可点回看 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding GoStepCommand}" CommandParameter="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <Border x:Name="Dot" Width="22" Height="22" CornerRadius="11"
                                                    Background="{DynamicResource Brush.CardWell}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="Num" Text="1" FontSize="10.5"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Muted}"/>
                                            </Border>
                                            <TextBlock x:Name="Cap" Text="选择文件" FontSize="11"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Muted}"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                <Setter TargetName="Dot" Property="Background"
                                                        Value="{DynamicResource Brush.PrimaryDim}"/>
                                                <Setter TargetName="Dot" Property="BorderBrush"
                                                        Value="{DynamicResource Brush.PrimaryLine}"/>
                                                <Setter TargetName="Num" Property="Foreground"
                                                        Value="{DynamicResource Brush.Primary}"/>
                                                <Setter TargetName="Cap" Property="Foreground"
                                                        Value="{DynamicResource Brush.Primary}"/>
                                                <Setter TargetName="Cap" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Border Grid.Column="1" Height="1" Margin="8,0"
                                    Background="{DynamicResource Brush.SepLine}" VerticalAlignment="Center"/>

                            <Button Grid.Column="2" Command="{Binding GoStepCommand}" CommandParameter="2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <Border x:Name="Dot" Width="22" Height="22" CornerRadius="11"
                                                    Background="{DynamicResource Brush.CardWell}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="Num" Text="2" FontSize="10.5"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Muted}"/>
                                            </Border>
                                            <TextBlock x:Name="Cap" Text="列映射" FontSize="11"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Muted}"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                <Setter TargetName="Dot" Property="Background"
                                                        Value="{DynamicResource Brush.PrimaryDim}"/>
                                                <Setter TargetName="Dot" Property="BorderBrush"
                                                        Value="{DynamicResource Brush.PrimaryLine}"/>
                                                <Setter TargetName="Num" Property="Foreground"
                                                        Value="{DynamicResource Brush.Primary}"/>
                                                <Setter TargetName="Cap" Property="Foreground"
                                                        Value="{DynamicResource Brush.Primary}"/>
                                                <Setter TargetName="Cap" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Border Grid.Column="3" Height="1" Margin="8,0"
                                    Background="{DynamicResource Brush.SepLine}" VerticalAlignment="Center"/>

                            <Button Grid.Column="4" Command="{Binding GoStepCommand}" CommandParameter="3">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <Border x:Name="Dot" Width="22" Height="22" CornerRadius="11"
                                                    Background="{DynamicResource Brush.CardWell}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="Num" Text="3" FontSize="10.5"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Muted}"/>
                                            </Border>
                                            <TextBlock x:Name="Cap" Text="校验预览" FontSize="11"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Muted}"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                <Setter TargetName="Dot" Property="Background"
                                                        Value="{DynamicResource Brush.PrimaryDim}"/>
                                                <Setter TargetName="Dot" Property="BorderBrush"
                                                        Value="{DynamicResource Brush.PrimaryLine}"/>
                                                <Setter TargetName="Num" Property="Foreground"
                                                        Value="{DynamicResource Brush.Primary}"/>
                                                <Setter TargetName="Cap" Property="Foreground"
                                                        Value="{DynamicResource Brush.Primary}"/>
                                                <Setter TargetName="Cap" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Border Grid.Column="5" Height="1" Margin="8,0"
                                    Background="{DynamicResource Brush.SepLine}" VerticalAlignment="Center"/>

                            <Button Grid.Column="6" Command="{Binding GoStepCommand}" CommandParameter="4">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <Border x:Name="Dot" Width="22" Height="22" CornerRadius="11"
                                                    Background="{DynamicResource Brush.CardWell}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="Num" Text="4" FontSize="10.5"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Muted}"/>
                                            </Border>
                                            <TextBlock x:Name="Cap" Text="确认导入" FontSize="11"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Muted}"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                                <Setter TargetName="Dot" Property="Background"
                                                        Value="{DynamicResource Brush.PrimaryDim}"/>
                                                <Setter TargetName="Dot" Property="BorderBrush"
                                                        Value="{DynamicResource Brush.PrimaryLine}"/>
                                                <Setter TargetName="Num" Property="Foreground"
                                                        Value="{DynamicResource Brush.Primary}"/>
                                                <Setter TargetName="Cap" Property="Foreground"
                                                        Value="{DynamicResource Brush.Primary}"/>
                                                <Setter TargetName="Cap" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- 当前步说明 -->
                        <Border Background="{DynamicResource Brush.CardWell}" CornerRadius="9"
                                Padding="11,7" Margin="0,11,0,0">
                            <TextBlock Style="{StaticResource T.Tiny}" FontSize="10" TextWrapping="Wrap">
                                <Run Text="{Binding StepTitle, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="  "/>
                                <Run Text="{Binding StepHint, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- 已选文件摘要（有预览时常驻，任何步骤都能看到源文件） -->
                    <Border Grid.Row="1" Background="{DynamicResource Brush.CardWell}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="12" Padding="12,9" Margin="0,10,0,0"
                            Visibility="{Binding HasPreview, Converter={StaticResource TrueToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                    Background="{DynamicResource Brush.PrimaryDim}" Margin="0,0,10,0">
                                <TextBlock Text="XLS" FontSize="9" FontWeight="Bold"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Preview.FileName}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Preview.FilePath}" Style="{StaticResource T.Mono}"
                                           FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Chip}" Tag="ok" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Preview.Total, StringFormat=有效 {0} 条}" FontSize="9.5"/>
                                </ContentControl>
                                <ContentControl Style="{StaticResource Chip}" Tag="warn"
                                                Visibility="{Binding Preview.ErrorCount, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="{Binding Preview.ErrorCount, StringFormat=错误 {0}}" FontSize="9.5"/>
                                </ContentControl>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 分步内容 -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <!-- 第 1 步：还没有预览时的引导 -->
                        <Border Padding="20" CornerRadius="12"
                                Background="{DynamicResource Brush.CardWell}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                VerticalAlignment="Top"
                                Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="还没有选择文件" Style="{StaticResource T.Value}"
                                           FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Style="{StaticResource T.Tiny}" FontSize="10.5"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Margin="0,7,0,0"
                                           Text="支持 .xls 与 .xlsx。点右上「选择文件并解析」，系统自动探测表头行、识别四阶段列，并在写入前给出逐行预览。"/>
                                <Button Content="选择文件并解析" Style="{StaticResource Btn.Primary}"
                                        Height="34" Width="150" Margin="0,14,0,10"
                                        HorizontalAlignment="Center"
                                        Command="{Binding PreviewCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- 第 2 步：列映射（解析产物，只读展示识别结果） -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsStep2, Converter={StaticResource TrueToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="系统识别出的列映射" Style="{StaticResource T.Label}" Margin="2,0,0,6"/>
                                <Border Background="{DynamicResource Brush.CardWell}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        CornerRadius="10" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,7">
                                            <TextBlock Text="表头行" Style="{StaticResource T.Tiny}" FontSize="10"/>
                                            <TextBlock Text="{Binding Preview.HeaderRowText}"
                                                       Style="{StaticResource T.Mono}" FontSize="10"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,7">
                                            <TextBlock Text="原始行数 / 有效问题" Style="{StaticResource T.Tiny}" FontSize="10"/>
                                            <TextBlock FontSize="10" HorizontalAlignment="Right"
                                                       FontFamily="{DynamicResource Font.Mono}">
                                                <Run Text="{Binding Preview.SourceRowCount, Mode=OneWay}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding Preview.Total, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                        <Border Style="{StaticResource Hairline}" Margin="0,4,0,8"/>
                                        <TextBlock Style="{StaticResource T.Tiny}" FontSize="10"
                                                   TextWrapping="Wrap" LineHeight="18"
                                                   Text="序号 / 机台号 / 存在问题 / 解决措施 + 四阶段的责任人与计划共 12 列按表头文字自动映射；分项目号由机台号百位段派生（1xx→P7391-01、2xx→02、3xx→03）。识别不出的列留空，不猜测。"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Style="{StaticResource T.Tiny}" FontSize="9.5" TextWrapping="Wrap"
                                           Margin="2,10,0,0"
                                           Text="映射规则与 Excel 无损口径见 AGENTS.md 第 9 节：日期原文照存（11.5 不会被格式化成年份）、`/` 与空白严格区分、序号不重排。"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 第 3 步：校验预览（逐行表） -->
                        <Grid Visibility="{Binding IsStep3, Converter={StaticResource TrueToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,2,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="逐行校验" Style="{StaticResource T.H2}" FontSize="13"/>
                                    <TextBlock Text="{Binding Preview.Total, StringFormat=共 {0} 行}"
                                               Style="{StaticResource T.Tiny}" Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ContentControl Style="{StaticResource Chip}" Tag="ok" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Preview.InsertCount, StringFormat=新增 {0}}" FontSize="9"/>
                                    </ContentControl>
                                    <ContentControl Style="{StaticResource Chip}" Tag="info" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Preview.UpdateCount, StringFormat=更新 {0}}" FontSize="9"/>
                                    </ContentControl>
                                    <ContentControl Style="{StaticResource Chip}" Tag="plain" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Preview.UnchangedCount, StringFormat=无变化 {0}}" FontSize="9"/>
                                    </ContentControl>
                                    <ContentControl Style="{StaticResource Chip}" Tag="ng">
                                        <TextBlock Text="{Binding Preview.ConflictCount, StringFormat=冲突 {0}}" FontSize="9"/>
                                    </ContentControl>
                                </StackPanel>
                            </Grid>

                            <ListView Grid.Row="1" Style="{StaticResource Grid.Table}"
                                      ItemsSource="{Binding Rows}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="源行" Width="50"
                                                        HeaderContainerStyle="{StaticResource Grid.Header}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SourceRow}" Margin="8,0,0,0"
                                                               FontFamily="{DynamicResource Font.Mono}"
                                                               FontSize="11" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="机台号" Width="94"
                                                        HeaderContainerStyle="{StaticResource Grid.Header}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MachineCode}" Margin="8,0,0,0"
                                                               FontFamily="{DynamicResource Font.Mono}"
                                                               FontSize="11" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="问题" Width="210"
                                                        HeaderContainerStyle="{StaticResource Grid.Header}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0"
                                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="类型" Width="66"
                                                        HeaderContainerStyle="{StaticResource Grid.Header}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl Style="{StaticResource Chip}"
                                                                    Tag="{Binding KindKind}" Margin="6,0,0,0"
                                                                    Padding="6,1">
                                                        <TextBlock Text="{Binding KindDisplay}" FontSize="9"/>
                                                    </ContentControl>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="提示" Width="200"
                                                        HeaderContainerStyle="{StaticResource Grid.Header}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding WarningText}" Margin="8,0,0,0"
                                                               Style="{StaticResource T.Tiny}" FontSize="9.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{Binding WarningText}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>

                        <!-- 第 4 步：确认导入 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsStep4, Converter={StaticResource TrueToVisibility}}">
                            <StackPanel>
                                <!-- 写入结果（导入后） -->
                                <Border Background="{DynamicResource Brush.OkSoft}"
                                        BorderBrush="{DynamicResource Brush.OkLine}" BorderThickness="1"
                                        CornerRadius="10" Padding="12,9" Margin="0,0,0,12"
                                        Visibility="{Binding HasImportResult, Converter={StaticResource TrueToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImportResultSummary}" Style="{StaticResource T.Value}"
                                                   FontSize="12" Foreground="{DynamicResource Brush.Ok}"/>
                                        <TextBlock Text="{Binding ImportMessages}" Style="{StaticResource T.Tiny}"
                                                   FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="写入策略" Style="{StaticResource T.Label}" Margin="2,0,0,6"/>
                                <ComboBox Style="{StaticResource Input.Combo}" Height="34"
                                          AutomationProperties.AutomationId="StrategyCombo"
                                          ItemsSource="{Binding Strategies}"
                                          SelectedItem="{Binding Strategy, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding Strategy.Hint}" Style="{StaticResource T.Tiny}"
                                           FontSize="9.5" TextWrapping="Wrap" Margin="2,5,0,0"/>

                                <Border Style="{StaticResource Card.Inset}" Padding="12,10" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="写入前请确认" Style="{StaticResource T.Tiny}" FontSize="10"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource T.Small}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19">
                                            <Run Text="将写入 "/>
                                            <Run Text="{Binding Preview.Total, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text=" 行 · 新增 "/>
                                            <Run Text="{Binding Preview.InsertCount, Mode=OneWay}"/>
                                            <Run Text=" · 更新 "/>
                                            <Run Text="{Binding Preview.UpdateCount, Mode=OneWay}"/>
                                            <Run Text=" · 冲突 "/>
                                            <Run Text="{Binding Preview.ConflictCount, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource T.Tiny}" FontSize="9.5"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"
                                                   Text="写入会记录批次号与逐行来源（源表第几行），可整批回溯；原 Excel 文件永不被修改。"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 底部：步进按钮 -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="导入可整批回滚 · 原 xls 永不被修改"
                                   Style="{StaticResource T.Tiny}" FontSize="9.5" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="上一步" Style="{StaticResource Btn.Ghost}" Height="32" Width="76"
                                    AutomationProperties.AutomationId="StepBackButton"
                                    Command="{Binding StepBackCommand}"/>
                            <Button Content="下一步" Style="{StaticResource Btn.Secondary}" Height="32" Width="76"
                                    Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="StepNextButton"
                                    Command="{Binding StepNextCommand}"
                                    Visibility="{Binding IsStep4, Converter={StaticResource InverseBoolToVisibility}}"/>
                            <Button Content="清空预览" Style="{StaticResource Btn.Ghost}" Height="32" Width="82"
                                    Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="ClearPreviewButton"
                                    Command="{Binding ClearPreviewCommand}"/>
                            <Button Content="写入数据库" Style="{StaticResource Btn.Primary}" Height="32" Width="104"
                                    Margin="8,0,0,0" FontSize="11.5"
                                    AutomationProperties.AutomationId="ApplyButton"
                                    IsEnabled="{Binding CanApply}"
                                    Command="{Binding ApplyCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== 右：导出 ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- 导出范围 -->
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="导出范围" Style="{StaticResource T.H2}" FontSize="14"/>
                                <ContentControl Style="{StaticResource Chip}" Tag="on"
                                                HorizontalAlignment="Right">
                                    <TextBlock Text="按库内实况" FontSize="9.5"/>
                                </ContentControl>
                            </Grid>
                            <ListBox ItemsSource="{Binding Scopes}"
                                     SelectedItem="{Binding Scope, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     AutomationProperties.AutomationId="ScopeList"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,5"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="9" Padding="10,7"
                                                            Background="{DynamicResource Brush.CardWell}"
                                                            BorderBrush="{DynamicResource Brush.Border}"
                                                            BorderThickness="1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                                    Value="{DynamicResource Brush.PrimaryLine}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource Brush.PrimaryDim}"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                                    Value="{DynamicResource Brush.Primary}"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness"
                                                                    Value="1.5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Fg}"/>
                                            <TextBlock Text="{Binding Hint}" FontSize="9.5"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource Brush.Muted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- 输出格式三选一 -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="输出格式" Style="{StaticResource T.H2}" FontSize="14"/>
                                <ContentControl Style="{StaticResource Chip}" Tag="plain"
                                                HorizontalAlignment="Right">
                                    <TextBlock Text="xlsx" FontSize="9.5"/>
                                </ContentControl>
                            </Grid>
                            <ListBox ItemsSource="{Binding Layouts}"
                                     SelectedItem="{Binding Layout, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     AutomationProperties.AutomationId="LayoutList"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,5"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="9" Padding="10,7"
                                                            Background="{DynamicResource Brush.CardWell}"
                                                            BorderBrush="{DynamicResource Brush.Border}"
                                                            BorderThickness="1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                                    Value="{DynamicResource Brush.PrimaryLine}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource Brush.PrimaryDim}"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                                    Value="{DynamicResource Brush.Primary}"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness"
                                                                    Value="1.5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Fg}"/>
                                            <TextBlock Text="{Binding Hint}" FontSize="9.5"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource Brush.Muted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- 选项 + 开始导出 -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="选项" Style="{StaticResource T.H2}" FontSize="14" Margin="0,0,0,9"/>
                            <CheckBox Style="{StaticResource Check.Box}" Content="包含附件清单 manifest.csv"
                                      Margin="0,0,0,7"
                                      AutomationProperties.AutomationId="IncludeAttachmentsCheck"
                                      IsChecked="{Binding IncludeAttachments, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource Check.Box}" Content="附修改留痕工作表"
                                      IsChecked="{Binding IncludeChangeLog, Mode=TwoWay}"/>

                            <Border Style="{StaticResource Hairline}" Margin="0,10,0,9"/>
                            <TextBlock Text="回写规则" Style="{StaticResource T.Tiny}" FontSize="10"
                                       FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource T.Tiny}" FontSize="9.5" TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       Text="按 ID 匹配已有行 → 更新四阶段与状态；原表有、系统无的行 → 新增；系统有、原表无的行 → 保留并在报告里列出，不擅自删除。"/>
                        </StackPanel>
                    </Border>

                    <!-- 移动端配对 -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="移动端配对" Style="{StaticResource T.H2}" FontSize="14"/>
                                <ContentControl Style="{StaticResource Chip}" Tag="warn"
                                                HorizontalAlignment="Right">
                                    <TextBlock Text="尚未启用" FontSize="9.5"/>
                                </ContentControl>
                            </Grid>

                            <Border Background="{DynamicResource Brush.WarnSoft}"
                                    BorderBrush="{DynamicResource Brush.WarnLine}" BorderThickness="1"
                                    CornerRadius="10" Padding="11,9">
                                <TextBlock Text="{Binding SyncStatusText}" Style="{StaticResource T.Small}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Warn}"/>
                            </Border>

                            <TextBlock Style="{StaticResource T.Tiny}" FontSize="9.5" TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Text="移动端离线优先：本地记录、拍照后进 outbox，联网时增量上传。桌面端为唯一主库，冲突按 version 判，手机端必须人工选择保留哪一份。"/>
                            <TextBlock Text="{Binding SyncPortDisplay}" Style="{StaticResource T.Mono}"
                                       FontSize="9.5" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource T.Tiny}" FontSize="9.5" TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Text="当前版本为离线单机批：不显示配对码，也不假装手机已连接。"/>

                            <Border Style="{StaticResource Hairline}" Margin="0,10,0,8"/>
                            <TextBlock Text="本机数据位置" Style="{StaticResource T.Tiny}" FontSize="10"/>
                            <TextBlock Text="{Binding DbPathDisplay}" Style="{StaticResource T.Mono}"
                                       FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding AttachmentsDirDisplay}" Style="{StaticResource T.Mono}"
                                       FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <!--
                  导出主操作固定在右栏底部：1440×900 下三张卡（范围/格式/选项）会把内容
                  顶出可视区，按钮若留在滚动区里就必须先滚到底才能点——自动化还会把它判成
                  offscreen。主操作常驻可见，滚动区只放"看"的内容。
                -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ExportEstimateText}" Style="{StaticResource T.Tiny}"
                                   FontSize="10" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ExportDirDisplay}" Style="{StaticResource T.Mono}"
                                   FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>

                        <Button Content="开始导出" Style="{StaticResource Btn.Primary}" Height="34"
                                Margin="0,9,0,0"
                                AutomationProperties.AutomationId="ExportButton"
                                Command="{Binding ExportCommand}"/>

                        <Border Background="{DynamicResource Brush.CardWell}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="10" Padding="11,8" Margin="0,9,0,0"
                                Visibility="{Binding HasExportResult, Converter={StaticResource TrueToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ExportResultSummary}" Style="{StaticResource T.Value}"
                                           FontSize="11.5"/>
                                <TextBlock Text="{Binding ExportResult.OutputPath}" Style="{StaticResource T.Mono}"
                                           FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                <Button Content="打开导出目录 →" Style="{StaticResource Btn.Ghost}" Height="24"
                                        Padding="0" FontSize="10.5" HorizontalAlignment="Left"
                                        Margin="0,4,0,0" Command="{Binding OpenExportFolderCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
