<UserControl x:Class="Sinan.App.Views.IssueDetailPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">

            <!-- ==================== 摘要卡 ==================== -->
            <Border Style="{StaticResource Card}" Padding="20,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="58" Height="58" CornerRadius="16"
                            Background="{DynamicResource Brush.PrimaryDim}"
                            BorderBrush="{DynamicResource Brush.PrimaryLine}" BorderThickness="1"
                            VerticalAlignment="Top" Margin="0,0,16,0">
                        <TextBlock Text="{Binding SeqDisplay}" FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="23" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Primary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Issue.Title}" Style="{StaticResource T.H1}" FontSize="19"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource T.Small}"/>
                            <TextBlock Text="·" Style="{StaticResource T.Small}" Margin="7,0"/>
                            <TextBlock Text="{Binding SourceTrace}" Style="{StaticResource T.Tiny}"
                                       FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ContentControl Style="{StaticResource Chip}" Tag="info">
                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10.5"/>
                            </ContentControl>
                            <ContentControl Style="{StaticResource Chip}" Tag="ng" Margin="6,0,0,0"
                                            Visibility="{Binding HasInverted, Converter={StaticResource TrueToVisibility}}">
                                <TextBlock Text="计划倒挂" FontSize="10.5"/>
                            </ContentControl>
                            <ContentControl Style="{StaticResource Chip}" Tag="on" Margin="6,0,0,0">
                                <TextBlock Text="{Binding ProgressText, StringFormat=阶段 {0}}" FontSize="10.5"/>
                            </ContentControl>
                            <ContentControl Style="{StaticResource Chip}" Tag="warn" Margin="6,0,0,0"
                                            Visibility="{Binding HasOverdue, Converter={StaticResource TrueToVisibility}}">
                                <TextBlock Text="{Binding OverdueDays, StringFormat=逾期 {0} 天}" FontSize="10.5"/>
                            </ContentControl>
                        </StackPanel>

                        <Border Style="{StaticResource Card.Inset}" Padding="12,9" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="解决措施" Style="{StaticResource T.Tiny}" FontSize="10"/>
                                <TextBlock Text="{Binding Issue.Solution}" Style="{StaticResource T.Small}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Top">
                        <Border Background="{DynamicResource Brush.CardWell}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="12" Padding="12,10" Width="240">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="设计下图" Style="{StaticResource T.Tiny}" FontSize="10"/>
                                    <TextBlock Text="{Binding Issue.DesignStage.DueDisplay}"
                                               Style="{StaticResource T.Mono}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding Issue.DesignStage.OwnerDisplay}"
                                           Style="{StaticResource T.Value}" FontSize="12" Margin="0,3,0,0"/>
                                <Border Style="{StaticResource Hairline}" Margin="0,8,0,8"/>
                                <Grid>
                                    <TextBlock Text="装配调试" Style="{StaticResource T.Tiny}" FontSize="10"/>
                                    <TextBlock Text="{Binding Issue.AssemblyStage.DueDisplay}"
                                               Style="{StaticResource T.Mono}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding Issue.AssemblyStage.OwnerDisplay}"
                                           Style="{StaticResource T.Value}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding UpdatedDisplay, StringFormat=最近更新 {0}}"
                                   Style="{StaticResource T.Tiny}" FontSize="10" HorizontalAlignment="Right"
                                   Margin="0,7,2,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 就地提示 -->
            <Border Padding="12,9" CornerRadius="10" Margin="0,12,0,0"
                    Background="{DynamicResource Brush.NgSoft}"
                    BorderBrush="{DynamicResource Brush.NgLine}" BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource TrueToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           FontSize="{DynamicResource Text.Size.Small}"
                           Foreground="{DynamicResource Brush.Ng}"/>
            </Border>
            <Border Padding="12,9" CornerRadius="10" Margin="0,12,0,0"
                    Background="{DynamicResource Brush.OkSoft}"
                    BorderBrush="{DynamicResource Brush.OkLine}" BorderThickness="1"
                    Visibility="{Binding HasNotice, Converter={StaticResource TrueToVisibility}}">
                <TextBlock Text="{Binding NoticeMessage}" TextWrapping="Wrap"
                           FontSize="{DynamicResource Text.Size.Small}"
                           Foreground="{DynamicResource Brush.Ok}"/>
            </Border>

            <!-- ==================== 主信息编辑 + 右栏 ==================== -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">

                    <!-- 主信息编辑 -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="问题主信息" Style="{StaticResource T.H2}" FontSize="15"/>
                                <TextBlock Text="保存前不会写库；标题与解决措施会进审计"
                                           Style="{StaticResource T.Tiny}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="问题描述" Style="{StaticResource T.Label}" Margin="2,0,0,5"/>
                            <TextBox Style="{StaticResource Input.Text}" Height="62"
                                     AutomationProperties.AutomationId="DetailTitleBox"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Padding="12,9"
                                     VerticalContentAlignment="Top" Margin="0,0,0,10"/>

                            <TextBlock Text="解决措施" Style="{StaticResource T.Label}" Margin="2,0,0,5"/>
                            <TextBox Style="{StaticResource Input.Text}" Height="58"
                                     AutomationProperties.AutomationId="DetailSolutionBox"
                                     Text="{Binding Solution, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Padding="12,9"
                                     VerticalContentAlignment="Top" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="完成情况" Style="{StaticResource T.Label}" Margin="2,0,0,5"/>
                                    <TextBox Style="{StaticResource Input.Text}" Height="34"
                                             AutomationProperties.AutomationId="DetailCompletionBox"
                                             Text="{Binding CompletionText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="分类 / 标签" Style="{StaticResource T.Label}" Margin="2,0,0,5"/>
                                    <TextBox Style="{StaticResource Input.Text}" Height="34"
                                             AutomationProperties.AutomationId="DetailCategoryBox"
                                             Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="优先级" Style="{StaticResource T.Label}" Margin="2,0,0,5"/>
                                    <ComboBox Style="{StaticResource Input.Combo}" Height="34"
                                              AutomationProperties.AutomationId="DetailPriorityCombo"
                                              ItemsSource="{Binding PriorityOptions}"
                                              SelectedItem="{Binding Priority, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="当前状态" Style="{StaticResource T.Tiny}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Style="{StaticResource Input.Combo}" Width="132" Height="32"
                                              AutomationProperties.AutomationId="DetailStatusCombo"
                                              ItemsSource="{Binding StatusOptions}"
                                              SelectedItem="{Binding Status, Mode=TwoWay}"/>
                                    <Button Content="更新状态" Style="{StaticResource Btn.Secondary}" Height="32"
                                            AutomationProperties.AutomationId="SetStatusButton"
                                            Margin="8,0,0,0" Command="{Binding SetStatusCommand}"/>
                                </StackPanel>
                                <Button Content="保存主信息" Style="{StaticResource Btn.Primary}" Height="34"
                                        AutomationProperties.AutomationId="SaveMainButton"
                                        Width="122" HorizontalAlignment="Right"
                                        Command="{Binding SaveDetailsCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 四阶段 -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="四阶段推进" Style="{StaticResource T.H2}" FontSize="15"/>
                                    <TextBlock Text="前一阶段完成或标 / 后才进入下一阶段"
                                               Style="{StaticResource T.Tiny}" Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="空白 ≠ 不适用；`/` 才是跳过" Style="{StaticResource T.Tiny}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <!-- 设计稿 dlg-stage 入口：一个窗口填完当前这一段 -->
                                    <Button Content="填写阶段" Style="{StaticResource Btn.Secondary}"
                                            Height="28" FontSize="11.5" Padding="12,0"
                                            AutomationProperties.AutomationId="OpenStageDialogButton"
                                            Command="{Binding EditStageCommand}"/>
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding StageEditors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Brush.CardWell}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                CornerRadius="14" Padding="14,11" Margin="0,0,0,9">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource T.Value}"
                                                                   FontSize="13" FontWeight="SemiBold"/>
                                                        <ContentControl Style="{StaticResource Chip}" Tag="on"
                                                                        Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding StateDisplay}"
                                                                       FontSize="9.5"/>
                                                        </ContentControl>
                                                    </StackPanel>
                                                    <Button Content="保存本阶段" Style="{StaticResource Btn.Secondary}"
                                                            AutomationProperties.AutomationId="{Binding Code, StringFormat=StageSave_{0}}"
                                                            Height="26" FontSize="11" Padding="10,0"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding SaveCommand}"/>
                                                </Grid>

                                                <Grid Margin="0,9,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="责任人（原文，可多人用 /）"
                                                                   Style="{StaticResource T.Tiny}" FontSize="9.5"
                                                                   Margin="1,0,0,4"/>
                                                        <TextBox Style="{StaticResource Input.Text}" Height="31"
                                                                 AutomationProperties.AutomationId="{Binding Code, StringFormat=StageOwner_{0}}"
                                                                 FontSize="11.5"
                                                                 Text="{Binding OwnerText, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                        <TextBlock Text="计划原文（11.5 / 已下图 / ）"
                                                                   Style="{StaticResource T.Tiny}" FontSize="9.5"
                                                                   Margin="1,0,0,4"/>
                                                        <TextBox Style="{StaticResource Input.Text}" Height="31"
                                                                 AutomationProperties.AutomationId="{Binding Code, StringFormat=StageDue_{0}}"
                                                                 FontSize="11.5"
                                                                 FontFamily="{DynamicResource Font.Mono}"
                                                                 Text="{Binding DueRaw, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="阶段状态"
                                                                   Style="{StaticResource T.Tiny}" FontSize="9.5"
                                                                   Margin="1,0,0,4"/>
                                                        <ComboBox Style="{StaticResource Input.Combo}" Height="31"
                                                                  AutomationProperties.AutomationId="{Binding Code, StringFormat=StageState_{0}}"
                                                                  FontSize="11.5"
                                                                  ItemsSource="{Binding StateOptions}"
                                                                  SelectedValuePath="State"
                                                                  SelectedValue="{Binding State, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Label}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="实际完成日"
                                                                   Style="{StaticResource T.Tiny}" FontSize="9.5"
                                                                   Margin="1,0,0,4"/>
                                                        <TextBox Style="{StaticResource Input.Text}" Height="31"
                                                                 AutomationProperties.AutomationId="{Binding Code, StringFormat=StageActual_{0}}"
                                                                 FontSize="11.5"
                                                                 FontFamily="{DynamicResource Font.Mono}"
                                                                 Text="{Binding ActualDateRaw, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="填 2026-11-20 这种日期；留空表示未完成"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="备注"
                                                                   Style="{StaticResource T.Tiny}" FontSize="9.5"
                                                                   Margin="1,0,0,4"/>
                                                        <TextBox Style="{StaticResource Input.Text}" Height="31"
                                                                 AutomationProperties.AutomationId="{Binding Code, StringFormat=StageRemark_{0}}"
                                                                 FontSize="11.5"
                                                                 Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource T.Tiny}" FontSize="10" TextWrapping="Wrap"
                                       Text="每段独立保存；计划日修改与责任人变更会留审计。倒挂只告警不阻断，按现计划无法按期交付时请在备注里写清原因。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 右栏 ==================== -->
                <StackPanel Grid.Column="1">

                    <!-- 附件 -->
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="现场照片 / 附件" Style="{StaticResource T.H2}" FontSize="14"/>
                                    <ContentControl Style="{StaticResource Chip}" Tag="on" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding PhotoCount, StringFormat={}{0} 个}" FontSize="9.5"/>
                                    </ContentControl>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="查看大图" Style="{StaticResource Btn.Ghost}" Height="24"
                                            Padding="0" FontSize="11" Margin="0,0,10,0"
                                            AutomationProperties.AutomationId="OpenPhotoViewerButton"
                                            Command="{Binding ViewPhotosCommand}"/>
                                    <Button Content="＋ 添加" Style="{StaticResource Btn.Ghost}" Height="24"
                                            Padding="0" FontSize="11"
                                            AutomationProperties.AutomationId="AddAttachmentButton"
                                            Command="{Binding AddAttachmentCommand}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 缩略图条：设计稿把照片直接贴在问题点旁，点开看大图 -->
                            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="72" Height="54" Margin="0,0,6,6" Padding="0"
                                                Background="{DynamicResource Brush.CardWell}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1" Cursor="Hand"
                                                ToolTip="{Binding FileName}"
                                                AutomationProperties.Name="{Binding FileName, StringFormat=查看 {0}}"
                                                Command="{Binding DataContext.ViewPhotosCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" CornerRadius="7"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="▣" FontSize="17"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Brush.Faint}"/>
                                                            <Border VerticalAlignment="Bottom"
                                                                    Background="#B3000000" Padding="4,2">
                                                                <TextBlock Text="{Binding SizeDisplay}" FontSize="8"
                                                                           Foreground="White"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <ContentControl Style="{StaticResource Chip}" Tag="warn"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top" Margin="3"
                                                                            MinHeight="14" Padding="5,0"
                                                                            Visibility="{Binding IsDemo, Converter={StaticResource TrueToVisibility}}">
                                                                <TextBlock Text="演示" FontSize="8"/>
                                                            </ContentControl>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                                    Value="{DynamicResource Brush.PrimaryLine}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.SepLine}"
                                                BorderThickness="0,0,0,1" Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FileName}" FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Brush.Fg}"/>
                                                        <ContentControl Style="{StaticResource Chip}" Tag="warn"
                                                                        Margin="6,0,0,0"
                                                                        Visibility="{Binding IsDemo, Converter={StaticResource TrueToVisibility}}">
                                                            <TextBlock Text="演示" FontSize="9"/>
                                                        </ContentControl>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource T.Tiny}" FontSize="9.5"
                                                               Margin="0,2,0,0">
                                                        <Run Text="{Binding SizeDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding CreatedDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="打开" Style="{StaticResource Btn.Ghost}" Height="22"
                                                            Padding="0" FontSize="10.5"
                                                            Command="{Binding DataContext.OpenAttachmentCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="删除" Style="{StaticResource Btn.Ghost}" Height="22"
                                                            Padding="0" FontSize="10.5" Margin="8,0,0,0"
                                                            Foreground="{DynamicResource Brush.Ng}"
                                                            Command="{Binding DataContext.DeleteAttachmentCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="还没有附件。历史 Excel 没有照片，演示附件只有元数据。"
                                       Style="{StaticResource T.Tiny}" FontSize="10" TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasAttachments, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 危险操作：删除问题（设计稿 dlg-del） -->
                    <Border Style="{StaticResource Card.Inset}" Padding="13,11" Margin="0,14,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="删除这条问题" Style="{StaticResource T.Small}" FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Fg}"/>
                                <TextBlock Text="软删除：统计与导出会移除它，留痕与照片文件保留"
                                           Style="{StaticResource T.Tiny}" FontSize="9.5"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Content="删除问题" Style="{StaticResource Btn.Ghost}" Height="28"
                                    FontSize="11" Padding="10,0" HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Brush.Ng}"
                                    AutomationProperties.AutomationId="OpenDeleteDialogButton"
                                    Command="{Binding DeleteIssueCommand}"/>
                        </Grid>
                    </Border>

                    <!-- 评论 -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="现场评论" Style="{StaticResource T.H2}" FontSize="14"
                                       Margin="0,0,0,8"/>
                            <TextBox Style="{StaticResource Input.Text}" Height="56"
                                     AutomationProperties.AutomationId="CommentBox"
                                     Text="{Binding CommentDraft, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Padding="10,8"
                                     VerticalContentAlignment="Top"
                                     ToolTip="记录现场口头结论、临时处理办法等"/>
                            <Button Content="添加评论" Style="{StaticResource Btn.Secondary}" Height="30"
                                    AutomationProperties.AutomationId="AddCommentButton"
                                    HorizontalAlignment="Right" FontSize="11.5" Margin="0,7,0,0"
                                    Command="{Binding AddCommentCommand}"/>

                            <ItemsControl ItemsSource="{Binding Comments}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.SepLine}"
                                                BorderThickness="0,0,0,1" Padding="0,7">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding UserName}" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Fg}"/>
                                                    <TextBlock Text="{Binding CreatedDisplay}"
                                                               Style="{StaticResource T.Mono}" FontSize="9.5"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Content}" Style="{StaticResource T.Small}"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 修改留痕 -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="修改留痕" Style="{StaticResource T.H2}" FontSize="14"/>
                                <TextBlock Text="字段级 old / new" Style="{StaticResource T.Tiny}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Activity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="6" Height="6"
                                                     Fill="{DynamicResource Brush.Primary}"
                                                     VerticalAlignment="Top" Margin="0,5,0,0"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Small}"
                                                           FontSize="11" TextWrapping="Wrap"/>
                                                <TextBlock Style="{StaticResource T.Tiny}" FontSize="9.5"
                                                           Margin="0,2,0,0">
                                                    <Run Text="{Binding CreatedDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding UserName, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="还没有修改记录。" Style="{StaticResource T.Tiny}" FontSize="10"
                                       Visibility="{Binding HasActivity, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card.Inset}" Padding="12,10" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="数据来源" Style="{StaticResource T.Tiny}" FontSize="10"/>
                            <TextBlock Text="{Binding SourceTrace}" Style="{StaticResource T.Small}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding CreatedDisplay, StringFormat=创建于 {0}}"
                                       Style="{StaticResource T.Tiny}" FontSize="9.5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
