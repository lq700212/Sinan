<ui:ChromeBorderlessWindow x:Class="Sinan.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Sinan.App.ViewModels"
        xmlns:views="clr-namespace:Sinan.App.Views"
        Title="司南 · P7391 安装调试问题闭环系统"
        Width="1440" Height="900" MinWidth="1280" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        CornerRadius="18" CaptionHeight="46"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}"
        Foreground="{DynamicResource Brush.Fg}">

    <ui:ChromeBorderlessWindow.Resources>
        <!-- 页面 VM → View 映射；ContentControl 只认 VM，View 不参与导航判断。 -->
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IssueListViewModel}">
            <views:IssueListPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IssueDetailViewModel}">
            <views:IssueDetailPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExchangeViewModel}">
            <views:ExchangePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
        <!-- 分项目 · 设备问题预览（设计稿 p1 project）：从总览页点分项目卡片进入。 -->
        <DataTemplate DataType="{x:Type vm:SubprojectViewModel}">
            <views:SubprojectPage/>
        </DataTemplate>
    </ui:ChromeBorderlessWindow.Resources>

    <Border CornerRadius="18" Background="{DynamicResource Brush.Bg}" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ==================== 顶栏（设计稿 .app-bar：46px / padding 0 14 / gap 10） ==================== -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Bar}"
                    BorderBrush="{DynamicResource Brush.SepLine}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 品牌印章 26×26 / 圆角 7 / 字 12 -->
                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7"
                            Background="{DynamicResource Brush.PrimaryGrad}"
                            VerticalAlignment="Center">
                        <TextBlock Text="司" Foreground="White" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- 标题 13.5 + 副标题 10（同一行，设计稿 .app-title span） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Fg}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="6,0,0,1"
                                   Foreground="{DynamicResource Brush.Muted}"
                                   VerticalAlignment="Center" MaxWidth="460"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- 状态胶囊组（设计稿 .app-status：gap 5 / margin-left 12） -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <ContentControl Style="{StaticResource Chip}" Tag="info" Margin="0,0,5,0">
                            <TextBlock FontSize="10">
                                <Run Text="{Binding SubprojectCount, Mode=OneWay}"/><Run Text=" 个分项目"/>
                            </TextBlock>
                        </ContentControl>
                        <ContentControl Style="{StaticResource Chip}" Tag="ok" Margin="0,0,5,0">
                            <TextBlock FontSize="10">
                                <Run Text="{Binding MachineCount, Mode=OneWay}"/><Run Text=" 台机台"/>
                            </TextBlock>
                        </ContentControl>
                        <ContentControl Style="{StaticResource Chip}" Tag="ng">
                            <TextBlock FontSize="10">
                                <Run Text="{Binding InvertedCount, Mode=OneWay}"/><Run Text=" 条倒挂"/>
                            </TextBlock>
                        </ContentControl>
                    </StackPanel>

                    <!-- 右侧操作组 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="← 返回" Style="{StaticResource Btn.Ghost}" Height="26"
                                Padding="8,0" FontSize="11.5" Margin="0,0,6,0"
                                Command="{Binding BackCommand}"
                                Visibility="{Binding CanGoBack, Converter={StaticResource TrueToVisibility}}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <TextBlock Text="{Binding ProjectCode}" FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <Button Content="＋ 新建问题" Style="{StaticResource Btn.Primary}"
                                Height="26" Padding="12,0" FontSize="11.5"
                                Command="{Binding NewIssueCommand}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <Button Content="⟳" Style="{StaticResource Btn.Icon}" FontSize="14"
                                Margin="4,0,0,0" ToolTip="刷新当前页" Command="{Binding RefreshCommand}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="{Binding ThemeIcon}" Style="{StaticResource Btn.Icon}" FontSize="13"
                                ToolTip="{Binding ThemeTip}" Command="{Binding ToggleThemeCommand}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <!-- 用户胶囊：头像 22 + 姓名 11.5（圆角走库内 KxCapsuleBorder，端头永远正圆） -->
                        <ui:KxCapsuleBorder Margin="6,0,2,0" Padding="2,2,8,2"
                                Background="{DynamicResource Brush.CardWell}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="{DynamicResource Brush.PrimaryDim}">
                                    <TextBlock Text="{Binding UserInitial}" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding UserName}" FontSize="11.5" FontWeight="SemiBold"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:KxCapsuleBorder>

                        <Button Content="退出" Style="{StaticResource Btn.Ghost}" Height="26" Padding="6,0"
                                FontSize="11" Command="{Binding SignOutCommand}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <Border Width="1" Height="18" Background="{DynamicResource Brush.SepLine}"
                                Margin="6,0,4,0"/>

                        <Button Content="—" Style="{StaticResource Btn.Icon}" Width="26" Height="26"
                                ToolTip="最小化" Click="OnMinimizeClick"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="▢" Style="{StaticResource Btn.Icon}" Width="26" Height="26"
                                FontSize="11" ToolTip="最大化/还原" Click="OnMaximizeClick"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Style="{StaticResource Btn.Icon}" Width="26" Height="26"
                                FontSize="11" ToolTip="关闭" Click="OnCloseClick"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 主体：玻璃柔光斑 + 页面 + 底部悬浮 Dock ==================== -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <Ellipse Width="620" Height="620" Fill="{DynamicResource Brush.MeshA}"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-260,-220,0" IsHitTestVisible="False"/>
                <Ellipse Width="520" Height="520" Fill="{DynamicResource Brush.MeshB}"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="-200,0,0,-240" IsHitTestVisible="False"/>
                <Ellipse Width="420" Height="420" Fill="{DynamicResource Brush.MeshC}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="160,200,0,0" IsHitTestVisible="False"/>

                <Grid Margin="20,16,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 页面内容：padding 20 / gap 18 由各页自己排，壳层不再额外加边 -->
                    <ContentControl Grid.Row="0" Content="{Binding CurrentPage}"/>

                    <!-- 底部悬浮玻璃 Dock（设计稿 .page .app-nav，圆角走 KxCapsuleBorder 半高） -->
                    <ui:KxCapsuleBorder Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,2,0,9" Padding="9,7"
                            Background="{DynamicResource Brush.GlassBgStrong}"
                            BorderBrush="{DynamicResource Brush.GlassLine}" BorderThickness="1"
                            Effect="{DynamicResource Fx.CardShadowSoft}">
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Nav.Item}"
                                            Margin="2,0"
                                            AutomationProperties.Name="{Binding Label}"
                                            AutomationProperties.AutomationId="{Binding Key}"
                                            Tag="{Binding IsActive}"
                                            Command="{Binding DataContext.NavigateCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            <ui:KxCapsuleBorder Margin="6,0,0,0" Padding="5,0" MinHeight="16"
                                                    Background="{DynamicResource Brush.CardWell}"
                                                    Visibility="{Binding HasBadge, Converter={StaticResource TrueToVisibility}}">
                                                <TextBlock Text="{Binding BadgeText}"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           FontSize="9.5" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Muted}"/>
                                            </ui:KxCapsuleBorder>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ui:KxCapsuleBorder>
                </Grid>
            </Grid>

            <!-- ==================== 底栏（设计稿 .app-foot：30px / 10.5px） ==================== -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Footer}"
                    BorderBrush="{DynamicResource Brush.SepLine}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource Dot}" Tag="ok" Width="6" Height="6"/>
                        <TextBlock Text="数据库已连接" FontSize="10.5" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Brush.Muted}"/>
                        <TextBlock Text="·" FontSize="10.5" Margin="7,0"
                                   Foreground="{DynamicResource Brush.Faint}"/>
                        <TextBlock Text="{Binding DataAsOf}" Style="{StaticResource T.Mono}" FontSize="10"/>
                        <TextBlock Text="·" FontSize="10.5" Margin="7,0"
                                   Foreground="{DynamicResource Brush.Faint}"/>
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource T.Mono}" FontSize="10"
                                   MaxWidth="700" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Faint}">
                            <Run Text="演示数据 P7391 · "/><Run Text="{Binding IssueTotal, Mode=OneWay}"/><Run Text=" 条问题 / "/><Run Text="{Binding MachineCount, Mode=OneWay}"/><Run Text=" 台机台 · 照片为演示占位"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:ChromeBorderlessWindow>
