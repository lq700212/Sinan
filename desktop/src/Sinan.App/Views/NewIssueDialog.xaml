<ui:ChromeDialogWindow x:Class="Sinan.App.Views.NewIssueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
        Title="新建问题"
        Subtitle="{Binding ProjectCode, StringFormat={}{0} · 现场问题录入}"
        TitleIconChar="＋"
        Width="820" Height="780"
        Resizeable="False"
        CaptionHeight="40"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}"
        Foreground="{DynamicResource Brush.Fg}">

    <Grid Margin="24,14,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <ContentControl Style="{StaticResource Chip}" Tag="info" Margin="0,0,8,0">
                <TextBlock Text="机台不存在会自动建档并归组" FontSize="12"/>
            </ContentControl>
            <ContentControl Style="{StaticResource Chip}" Tag="on">
                <TextBlock Text="计划原文照存，不猜测年份" FontSize="12"/>
            </ContentControl>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,14,0">

                <!-- 机台 / 序号 / 优先级 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="机台号 *" Style="{StaticResource T.Label}" Margin="2,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource Input.Text}"
                                     AutomationProperties.AutomationId="MachineCodeBox"
                                     Text="{Binding MachineCode, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource Input.Combo}" Width="132"
                                      AutomationProperties.AutomationId="MachinePickCombo"
                                      Margin="8,0,0,0" ItemsSource="{Binding MachineOptions}"
                                      SelectedItem="{Binding MachineCode, Mode=TwoWay}"
                                      ToolTip="从在册机台中选择"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="序号" Style="{StaticResource T.Label}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource Input.Text}"
                                 AutomationProperties.AutomationId="SeqNoBox"
                                 Text="{Binding SeqNo, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{DynamicResource Font.Mono}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="优先级" Style="{StaticResource T.Label}" Margin="2,0,0,6"/>
                        <ComboBox Style="{StaticResource Input.Combo}"
                                  AutomationProperties.AutomationId="PriorityCombo"
                                  ItemsSource="{Binding PriorityOptions}"
                                  SelectedItem="{Binding Priority, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <!-- 问题描述 -->
                <TextBlock Text="问题描述 *" Style="{StaticResource T.Label}" Margin="2,0,0,6"/>
                <TextBox Style="{StaticResource Input.Text}" Height="68" Margin="0,0,0,14"
                         AutomationProperties.AutomationId="TitleBox"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Padding="12,9"
                         VerticalContentAlignment="Top"
                         ToolTip="写清哪台机台、哪个部位、什么现象"/>

                <!-- 解决措施 -->
                <TextBlock Text="解决措施" Style="{StaticResource T.Label}" Margin="2,0,0,6"/>
                <TextBox Style="{StaticResource Input.Text}" Height="60" Margin="0,0,0,14"
                         AutomationProperties.AutomationId="SolutionBox"
                         Text="{Binding Solution, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Padding="12,9"
                         VerticalContentAlignment="Top"/>

                <!-- 分类 -->
                <TextBlock Text="分类 / 标签（可选）" Style="{StaticResource T.Label}" Margin="2,0,0,6"/>
                <TextBox Style="{StaticResource Input.Text}" Margin="0,0,0,16"
                         AutomationProperties.AutomationId="CategoryBox"
                         Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="例如：气路、传感器、结构件"/>

                <!-- 四阶段 -->
                <Border Style="{StaticResource Card.Inset}" Padding="16,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="四阶段推进" Style="{StaticResource T.H2}" FontSize="15"/>
                            <TextBlock Text="可先只填方案；其余阶段之后在详情页推进"
                                       Style="{StaticResource T.Tiny}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="阶段" Style="{StaticResource T.Tiny}"/>
                            <TextBlock Grid.Column="1" Text="责任人" Style="{StaticResource T.Tiny}" Margin="4,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="计划原文" Style="{StaticResource T.Tiny}" Margin="4,0,0,0"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Stages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Style="{StaticResource T.Value}" FontSize="13.5"
                                                   VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource Input.Text}" Height="32"
                                                 AutomationProperties.AutomationId="{Binding Code, StringFormat=StageOwner_{0}}"
                                                 Margin="0,0,8,0" FontSize="13.5"
                                                 Text="{Binding OwnerText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Style="{StaticResource Input.Text}" Height="32"
                                                 AutomationProperties.AutomationId="{Binding Code, StringFormat=StageDue_{0}}"
                                                 FontSize="13.5" FontFamily="{DynamicResource Font.Mono}"
                                                 Text="{Binding DueRaw, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="11.5 / 2026-11-05 / 已下图 / （斜杠表示此阶段不适用）"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource T.Tiny}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="计划写“/”表示该阶段不适用；写“已下图”表示设计已完成；留空表示尚未安排。原样保存，导出时原样还原。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 错误就地展开 -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,9" CornerRadius="10"
                Background="{DynamicResource Brush.NgSoft}"
                BorderBrush="{DynamicResource Brush.NgLine}" BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource TrueToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       FontSize="{DynamicResource Text.Size.Small}"
                       Foreground="{DynamicResource Brush.Ng}"/>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Style="{StaticResource Dot}" Tag="info"/>
                <TextBlock Text="保存后进入问题详情，可继续推进阶段或添加照片"
                           Style="{StaticResource T.Tiny}" Margin="7,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Btn.Secondary}" Width="88"
                        AutomationProperties.AutomationId="NewIssueCancelButton"
                        Command="{Binding CancelCommand}" IsCancel="True"/>
                <Button Content="创建问题" Style="{StaticResource Btn.Primary}" Width="116"
                        Margin="10,0,0,0"
                        AutomationProperties.AutomationId="NewIssueSaveButton"
                        Command="{Binding SaveCommand}" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:ChromeDialogWindow>
