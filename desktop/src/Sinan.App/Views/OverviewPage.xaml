<UserControl x:Class="Sinan.App.Views.OverviewPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">

            <!-- ==================== 总项目头卡 ==================== -->
            <Border Style="{StaticResource Card}" Padding="24,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProjectCode}" FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="30" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Primary}"/>
                            <ui:KxCapsuleBorder Margin="12,6,0,0" Padding="9,3"
                                    Background="{DynamicResource Brush.OkSoft}"
                                    BorderBrush="{DynamicResource Brush.OkLine}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusDisplay}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Ok}"/>
                            </ui:KxCapsuleBorder>
                            <ui:KxCapsuleBorder Margin="8,6,0,0" Padding="9,3"
                                    Background="{DynamicResource Brush.PrimaryDim}"
                                    BorderBrush="{DynamicResource Brush.PrimaryLine}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="总项目" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Primary}"/>
                            </ui:KxCapsuleBorder>
                        </StackPanel>

                        <TextBlock Text="{Binding ProjectName}" Style="{StaticResource T.H1}" FontSize="19"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding MachineIssueSummary}" Style="{StaticResource T.Small}"
                                   Margin="0,5,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <ContentControl Style="{StaticResource Chip}" Tag="info" Margin="0,0,8,0">
                                <TextBlock FontSize="11">
                                    <Run Text="照片 "/><Run Text="{Binding PhotoCount, Mode=OneWay}"/><Run Text=" 张 · 演示值"/>
                                </TextBlock>
                            </ContentControl>
                            <ContentControl Style="{StaticResource Chip}" Tag="on" Margin="0,0,8,0">
                                <TextBlock FontSize="11">
                                    <Run Text="最近导入 "/><Run Text="{Binding LastImportDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </ContentControl>
                            <ContentControl Style="{StaticResource Chip}" Tag="warn"
                                            Visibility="{Binding HasUnassigned, Converter={StaticResource TrueToVisibility}}">
                                <TextBlock Text="{Binding UnassignedSummary}" FontSize="11"/>
                            </ContentControl>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <Button Content="进入工作台 →" Style="{StaticResource Btn.Primary}"
                                HorizontalAlignment="Right" Command="{Binding GoDashboardCommand}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="问题台账" Style="{StaticResource Btn.Secondary}" Height="30"
                                    FontSize="12" Command="{Binding GoIssuesCommand}"/>
                            <Button Content="数据交换" Style="{StaticResource Btn.Secondary}" Height="30"
                                    FontSize="12" Margin="8,0,0,0" Command="{Binding GoExchangeCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== KPI 四格 ==================== -->
            <UniformGrid Columns="4" Margin="0,18,0,0">
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,13,0">
                    <StackPanel>
                        <TextBlock Text="分项目" Style="{StaticResource T.Tiny}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding SubprojectCount}" Style="{StaticResource T.H1}"
                                       FontFamily="{DynamicResource Font.Mono}"/>
                            <TextBlock Text=" 个" Style="{StaticResource T.Small}" VerticalAlignment="Bottom"
                                       Margin="4,0,0,3"/>
                        </StackPanel>
                        <TextBlock Text="1xx / 2xx / 3xx 三段 + 待确认" Style="{StaticResource T.Tiny}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,13,0">
                    <StackPanel>
                        <TextBlock Text="在册机台" Style="{StaticResource T.Tiny}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding MachineCount}" Style="{StaticResource T.H1}"
                                       FontFamily="{DynamicResource Font.Mono}"/>
                            <TextBlock Text=" 台" Style="{StaticResource T.Small}" VerticalAlignment="Bottom"
                                       Margin="4,0,0,3"/>
                        </StackPanel>
                        <TextBlock Text="来自台账实际机台号" Style="{StaticResource T.Tiny}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,13,0">
                    <StackPanel>
                        <TextBlock Text="在册问题" Style="{StaticResource T.Tiny}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding IssueCount}" Style="{StaticResource T.H1}"
                                       FontFamily="{DynamicResource Font.Mono}"/>
                            <TextBlock Text=" 条" Style="{StaticResource T.Small}" VerticalAlignment="Bottom"
                                       Margin="4,0,0,3"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PhotoSummary}" Style="{StaticResource T.Tiny}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="计划倒挂" Style="{StaticResource T.Tiny}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding InvertedCount}" Style="{StaticResource T.H1}"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       Foreground="{DynamicResource Brush.Ng}"/>
                            <TextBlock Text=" 条" Style="{StaticResource T.Small}" VerticalAlignment="Bottom"
                                       Margin="4,0,0,3"/>
                        </StackPanel>
                        <TextBlock Text="设计计划晚于装配计划" Style="{StaticResource T.Tiny}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ==================== 分项目卡片 ==================== -->
            <Grid Margin="0,18,0,0">
                <TextBlock Text="分项目" Style="{StaticResource T.H2}"/>
                <TextBlock Text="点卡片进入该分项目的问题清单" Style="{StaticResource T.Tiny}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Cards}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,13,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Code}" FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="15.5" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Fg}"/>
                                    <ContentControl HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                                                <Setter Property="Tag" Value="ok"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnassigned}" Value="True">
                                                        <Setter Property="Tag" Value="ng"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="10.5"/>
                                    </ContentControl>
                                </Grid>

                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Small}" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding MachineRange}" Style="{StaticResource T.Tiny}"
                                           FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding MachineCount}" Style="{StaticResource T.H2}"
                                                   FontFamily="{DynamicResource Font.Mono}" FontSize="17"/>
                                        <TextBlock Text="机台" Style="{StaticResource T.Tiny}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding IssueCount}" Style="{StaticResource T.H2}"
                                                   FontFamily="{DynamicResource Font.Mono}" FontSize="17"/>
                                        <TextBlock Text="问题" Style="{StaticResource T.Tiny}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding InvertedCount}" Style="{StaticResource T.H2}"
                                                   FontFamily="{DynamicResource Font.Mono}" FontSize="17"
                                                   Foreground="{DynamicResource Brush.Ng}"/>
                                        <TextBlock Text="倒挂" Style="{StaticResource T.Tiny}" FontSize="10"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource Hairline}" Margin="0,10,0,8"/>

                                <Grid>
                                    <TextBlock Style="{StaticResource T.Tiny}" FontSize="10" VerticalAlignment="Center">
                                        <Run Text="照片 "/><Run Text="{Binding PhotoCount, Mode=OneWay}"/><Run Text=" · 责任人 "/><Run Text="{Binding OwnerCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>

                                <Button Content="查看问题 →" Style="{StaticResource Btn.Secondary}" Height="28"
                                        FontSize="11.5" Margin="0,10,0,0"
                                        AutomationProperties.Name="{Binding Code, StringFormat=查看 {0} 的设备问题}"
                                        AutomationProperties.AutomationId="{Binding Code, StringFormat=open-subproject-{0}}"
                                        Command="{Binding DataContext.OpenSubprojectCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Code}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ==================== 下排：分布 / 阶段 / 照片 ==================== -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 问题分布 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="问题分布" Style="{StaticResource T.H2}" FontSize="15"/>
                        <TextBlock Text="按分项目占比（条数 / 全量）" Style="{StaticResource T.Tiny}" Margin="0,3,0,12"/>

                        <ItemsControl ItemsSource="{Binding Distribution}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Value}"
                                                       FontFamily="{DynamicResource Font.Mono}" FontSize="11.5"/>
                                            <TextBlock Text="{Binding PercentText}" Style="{StaticResource T.Mono}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource Bar.Thin}" Height="6" Maximum="100"
                                                     Value="{Binding Percent, Mode=OneWay}" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Tiny}"
                                                   FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Hairline}" Margin="0,2,0,8"/>
                        <TextBlock Text="{Binding StageNote}" Style="{StaticResource T.Tiny}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 阶段填写率 -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="四阶段填写率" Style="{StaticResource T.H2}" FontSize="15"/>
                        <TextBlock Text="责任人 / 计划两项分别统计；`/` 不算已填" Style="{StaticResource T.Tiny}"
                                   Margin="0,3,0,12"/>

                        <ItemsControl ItemsSource="{Binding StageFills}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Value}"
                                                           FontSize="12"/>
                                                <ContentControl Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BadgeKind}" Value="ok">
                                                                    <Setter Property="Tag" Value="ok"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding BadgeKind}" Value="on">
                                                                    <Setter Property="Tag" Value="on"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                    <TextBlock Text="{Binding Badge}" FontSize="10"/>
                                                </ContentControl>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Mono}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="责任人" Style="{StaticResource T.Tiny}"
                                                       FontSize="10" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Style="{StaticResource Bar.Thin}" Height="6"
                                                         Maximum="100" Value="{Binding OwnerPercent, Mode=OneWay}"/>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="计划" Style="{StaticResource T.Tiny}"
                                                       FontSize="10" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Style="{StaticResource Bar.Thin}" Height="6"
                                                         Maximum="100" Value="{Binding DuePercent, Mode=OneWay}"
                                                         Foreground="{DynamicResource Brush.Accent}"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 照片覆盖 -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="照片覆盖（演示值）" Style="{StaticResource T.H2}" FontSize="15"/>
                        <TextBlock Text="历史 Excel 无附件；这里为演示元数据"
                                   Style="{StaticResource T.Tiny}" Margin="0,3,0,12"/>

                        <ItemsControl ItemsSource="{Binding PhotoBuckets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Value}"
                                                       FontFamily="{DynamicResource Font.Mono}" FontSize="11.5"/>
                                            <TextBlock Text="{Binding Count, StringFormat={}{0} 张}"
                                                       Style="{StaticResource T.Mono}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource Bar.Thin}" Height="6" Maximum="100"
                                                     Value="{Binding Ratio, Mode=OneWay}" Margin="0,5,0,0"
                                                     Foreground="{DynamicResource Brush.Accent}"/>
                                        <TextBlock Style="{StaticResource T.Tiny}" FontSize="10" Margin="0,3,0,0">
                                            <Run Text="{Binding IssueCount, Mode=OneWay}"/><Run Text=" 条问题有附件"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Hairline}" Margin="0,2,0,8"/>
                        <TextBlock Style="{StaticResource T.Tiny}" TextWrapping="Wrap"
                                   Text="照片按 attachments/{issueId}/ 存放，导出 ZIP 附带 manifest.csv；界面演示照片不写入导出包。"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== 待确认提示 ==================== -->
            <Border Margin="0,18,0,0" Padding="18,14"
                    CornerRadius="{DynamicResource Radius.CardInset}"
                    Background="{DynamicResource Brush.WarnSoft}"
                    BorderBrush="{DynamicResource Brush.WarnLine}" BorderThickness="1"
                    Visibility="{Binding HasUnassigned, Converter={StaticResource TrueToVisibility}}">
                <Grid>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource Dot}" Tag="warn"/>
                            <TextBlock Text="机台号异常，需要人工归组" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Warn}" Margin="8,0,0,0"
                                       FontSize="13"/>
                        </StackPanel>
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource T.Small}"
                                   Text="原表里存在位数不符的机台号（如 P73913118）。系统不猜归属，统一放入「待确认」；确认后可在台账中校正机台号。"/>
                    </StackPanel>
                    <Button Content="去查看 →" Style="{StaticResource Btn.Secondary}" Height="30"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding OpenSubprojectCommand}" CommandParameter="待确认"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
