<ui:ChromeDialogWindow x:Class="Sinan.App.Views.PhotoViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
        Title="现场照片"
        Subtitle="{Binding HeaderSubtitle}"
        TitleIconChar="▣"
        Width="900" Height="600"
        Resizeable="True"
        CaptionHeight="40"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}"
        Foreground="{DynamicResource Brush.Fg}">

    <!--
      ============================================================================
      查看现场照片（设计稿 dlg-photo）
      左大图 / 右元数据 / 底部上一张下一张。
      图片按需从磁盘读（附件表只存相对路径），缺失时就地说明不弹框：
      演示附件、尚未同步到本机都会走到占位分支。
      ============================================================================
    -->

    <Grid Margin="18,12,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="286"/>
        </Grid.ColumnDefinitions>

        <!-- 大图区 -->
        <Border Grid.Row="0" Grid.Column="0" Background="#06121A" CornerRadius="12"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Margin="0,0,12,0">
            <Grid>
                <Image Source="{Binding CurrentImage}" Stretch="Uniform" Margin="10"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasImage, Converter={StaticResource TrueToVisibility}}"/>

                <!-- 无图占位：给出原因，不让用户对着空白猜 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                            Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="▣" FontSize="46" HorizontalAlignment="Center"
                               Foreground="#3A4A54"/>
                    <TextBlock Text="{Binding MissingHint}" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="12.5" Margin="0,12,0,0" Foreground="#8FA3AE"/>
                </StackPanel>

                <!-- 文件名角标 -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                        Padding="8,3" CornerRadius="8" Background="#B3000000"
                        Visibility="{Binding HasImage, Converter={StaticResource TrueToVisibility}}">
                    <TextBlock Text="{Binding FileName}" FontSize="10"
                               FontFamily="{DynamicResource Font.Mono}" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- 元数据 -->
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="关联问题" Style="{StaticResource T.Tiny}" FontSize="10.5"/>
                    <TextBlock Text="{Binding IssueCode}" FontFamily="{DynamicResource Font.Mono}"
                               FontSize="13.5" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Fg}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding IssueTitle}" Style="{StaticResource T.Small}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="照片说明" Style="{StaticResource T.Tiny}" FontSize="10.5"/>
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource T.Small}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="拍摄人 / 时间" Style="{StaticResource T.Tiny}" FontSize="10.5"/>
                    <TextBlock FontSize="12" Margin="0,3,0,0">
                        <Run Text="{Binding UploadedBy, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TakenAtDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock Text="原始文件" Style="{StaticResource T.Tiny}" FontSize="10.5"/>
                    <TextBlock Text="{Binding FileName}" FontFamily="{DynamicResource Font.Mono}"
                               FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0">
                        <Run Text="{Binding DimensionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="设备 / 分项目" Style="{StaticResource T.Tiny}" FontSize="10.5"/>
                    <TextBlock FontSize="12" Margin="0,3,0,0">
                        <Run Text="{Binding MachineCode, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding SubprojectCode, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}"/>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Row="5" Style="{StaticResource Card.Inset}" Padding="10,8"
                        VerticalAlignment="Bottom" Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource Brush.Muted}"
                               Text="附件表只存相对路径，不把图片二进制塞进数据库；缩略图按需生成。"/>
                </Border>

                <TextBlock Grid.Row="6" Text="{Binding MissingHint}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource Brush.Ng}" Margin="0,8,0,0"
                           Visibility="{Binding ShowDetailHint, Converter={StaticResource TrueToVisibility}}"/>
            </Grid>
        </Border>

        <!-- 底部：翻页 + 关闭 -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl Style="{StaticResource Chip}" Tag="plain">
                    <TextBlock Text="{Binding Count, StringFormat=共 {0} 张}" FontSize="10.5"/>
                </ContentControl>
                <TextBlock Text="演示照片只有元数据、没有图片文件" Style="{StaticResource T.Tiny}"
                           FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="‹ 上一张" Style="{StaticResource Btn.Ghost}" Height="30" Width="82"
                        AutomationProperties.AutomationId="PhotoPrevButton"
                        Command="{Binding PrevCommand}"/>
                <Button Content="下一张 ›" Style="{StaticResource Btn.Ghost}" Height="30" Width="82"
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="PhotoNextButton"
                        Command="{Binding NextCommand}"/>
                <Button Content="关闭" Style="{StaticResource Btn.Secondary}" Height="30" Width="76"
                        Margin="12,0,0,0" IsCancel="True"
                        AutomationProperties.AutomationId="PhotoCloseButton"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:ChromeDialogWindow>
