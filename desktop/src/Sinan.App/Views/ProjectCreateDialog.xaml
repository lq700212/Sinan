<ui:ChromeDialogWindow x:Class="Sinan.App.Views.ProjectCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
        Title="新建总项目"
        Subtitle="自动创建 01 / 02 / 03 三个分项目"
        TitleIconChar="＋"
        Width="560" Height="470"
        Resizeable="False"
        CaptionHeight="40"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}"
        Foreground="{DynamicResource Brush.Fg}">

    <!--
      ============================================================================
      新建总项目
        - 项目号：P + 4 位数字（P7392），重复/格式错就地报错；
        - 名称必填，客户可空；
        - 保存后由 ProjectRepository.CreateProject 自动建 01/02/03 三个分项目，
          并写 change_log 让手机端同步拿到新项目。
      纪律：这里不造机台/问题演示数据，留给 Excel 导入或现场新建。
      ============================================================================
    -->

    <Grid Margin="24,14,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="项目号" Style="{StaticResource T.Label}" Margin="2,0,0,5"/>
            <TextBox Style="{StaticResource Input.Text}" Height="32"
                     FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                     MaxLength="5"
                     AutomationProperties.AutomationId="ProjectCodeBox"
                     Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding CodeHint}" Style="{StaticResource T.Tiny}" FontSize="10.5"
                       Margin="2,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock Text="项目名称" Style="{StaticResource T.Label}" Margin="2,0,0,5"/>
            <TextBox Style="{StaticResource Input.Text}" Height="32"
                     AutomationProperties.AutomationId="ProjectNameBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding NameHint}" Style="{StaticResource T.Tiny}" FontSize="10.5"
                       Margin="2,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="客户（可空）" Style="{StaticResource T.Label}" Margin="2,0,0,5"/>
            <TextBox Style="{StaticResource Input.Text}" Height="32"
                     AutomationProperties.AutomationId="ProjectCustomerBox"
                     Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding CustomerHint}" Style="{StaticResource T.Tiny}" FontSize="10.5"
                       Margin="2,4,0,0"/>
        </StackPanel>

        <!-- 错误就地常驻：放滚动区外面，用户不会因为没滚到底而看不到 -->
        <Border Grid.Row="3" Margin="0,14,0,0" Padding="11,8"
                Background="{DynamicResource Brush.NgSoft}"
                BorderBrush="{DynamicResource Brush.NgLine}" BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding HasError, Converter={StaticResource TrueToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="11"
                       Foreground="{DynamicResource Brush.Ng}" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <TextBlock Text="新建后自动切换到该项目" Style="{StaticResource T.Tiny}"
                       FontSize="10.5" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Btn.Ghost}" Height="34" Width="82"
                        AutomationProperties.AutomationId="ProjectCreateCancelButton"
                        Command="{Binding CancelCommand}"/>
                <Button Content="创建并切换" Style="{StaticResource Btn.Primary}" Height="34"
                        Padding="14,0" Margin="10,0,0,0"
                        AutomationProperties.AutomationId="ProjectCreateConfirmButton"
                        Command="{Binding CreateCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:ChromeDialogWindow>
