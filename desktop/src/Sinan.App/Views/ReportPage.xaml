<UserControl x:Class="Sinan.App.Views.ReportPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}">

    <!--
      ============================================================================
      统计报表（设计稿 report 页）
      结构：4 张 KPI → 责任人任务量 + 计划时间分布 → 阶段填写率 / 照片分布 / 本期结论
      纪律：所有数字来自 ProjectRepository.GetReport()，页面不二次计算百分比；
            演示附件必须标"演示值"；日期分布只吃语义日期，文字计划单独计数。
      ============================================================================
    -->

    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== KPI ==================== -->
        <UniformGrid Grid.Row="0" Columns="4">
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="问题总数" Style="{StaticResource T.Tiny}" FontSize="10.5" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,6,0,0">
                        <Run Text="{Binding TotalIssues, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                             FontFamily="{DynamicResource Font.Mono}"/>
                        <Run Text=" 条" FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding IssueSubtitle}" Style="{StaticResource T.Tiny}" FontSize="10"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="涉及机台" Style="{StaticResource T.Tiny}" FontSize="10.5" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,6,0,0">
                        <Run Text="{Binding TotalMachines, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                             FontFamily="{DynamicResource Font.Mono}"/>
                        <Run Text=" 台" FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding MachineSubtitle}" Style="{StaticResource T.Tiny}" FontSize="10"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="计划倒挂" Style="{StaticResource T.Tiny}" FontSize="10.5" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Brush.Warn}">
                        <Run Text="{Binding InvertedCount, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                             FontFamily="{DynamicResource Font.Mono}"/>
                        <Run Text=" 条" FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding InvertedSubtitle}" Style="{StaticResource T.Tiny}" FontSize="10"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="现场照片" Style="{StaticResource T.Tiny}" FontSize="10.5" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Brush.Ok}">
                        <Run Text="{Binding PhotoCount, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                             FontFamily="{DynamicResource Font.Mono}"/>
                        <Run Text=" 张" FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding PhotoSubtitle}" Style="{StaticResource T.Tiny}" FontSize="10"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ==================== 责任人 + 计划分布 ==================== -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：责任人任务量 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,14,9">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" CornerRadius="6"
                                    Background="{DynamicResource Brush.PrimaryDim}">
                                <TextBlock Text="◍" FontSize="11"
                                           Foreground="{DynamicResource Brush.Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="责任人任务量" FontSize="12.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Fg}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ContentControl Style="{StaticResource Chip}" Tag="plain"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        MinHeight="17" Padding="7,0">
                            <TextBlock Text="按阶段计数" FontSize="9"/>
                        </ContentControl>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,0,14,6">
                            <ItemsControl ItemsSource="{Binding OwnerBars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7" Height="18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.Muted}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Grid.Column="1" Style="{StaticResource Bar.Thin}"
                                                         Height="7" Maximum="100"
                                                         Value="{Binding Ratio, Mode=OneWay}"
                                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TaskText}" FontSize="10"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       Foreground="{DynamicResource Brush.Fg}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding OwnerSummaryText}" Style="{StaticResource T.Tiny}"
                                       FontSize="9.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                       LineHeight="15"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{DynamicResource Brush.CardWell}"
                            BorderBrush="{DynamicResource Brush.SepLine}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,13,13" Padding="14,8">
                        <Grid>
                            <TextBlock Text="{Binding OwnerFooter}" Style="{StaticResource T.Tiny}"
                                       FontSize="10" VerticalAlignment="Center"/>
                            <ContentControl Style="{StaticResource Chip}" Tag="{Binding OwnerBadgeKind}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            MinHeight="17" Padding="7,0">
                                <TextBlock Text="{Binding OwnerBadgeText}" FontSize="9"/>
                            </ContentControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 右：计划时间分布 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,14,9">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" CornerRadius="6"
                                    Background="{DynamicResource Brush.PrimaryDim}">
                                <TextBlock Text="◷" FontSize="11"
                                           Foreground="{DynamicResource Brush.Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="计划时间分布" FontSize="12.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Fg}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ContentControl Style="{StaticResource Chip}" Tag="plain"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        MinHeight="17" Padding="7,0">
                            <TextBlock Text="前 5 个日期" FontSize="9"/>
                        </ContentControl>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,4,14,10">
                            <ItemsControl ItemsSource="{Binding PlanDateBars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8" Height="18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DateText}" FontSize="9.5"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       Foreground="{DynamicResource Brush.Muted}"
                                                       VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Style="{StaticResource Bar.Thin}"
                                                         Height="7" Maximum="100"
                                                         Value="{Binding Ratio, Mode=OneWay}"
                                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="10"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       Foreground="{DynamicResource Brush.Fg}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock FontSize="10" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Tiny}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlanDateBars.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="没有可比较的计划日期。"/>
                            </TextBlock>

                            <!-- 倒挂装配计划集中情况（设计稿 callout） -->
                            <Border Style="{StaticResource Card.Inset}" Padding="11,9" Margin="0,8,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource Chip}" Tag="warn"
                                                        MinHeight="17" Padding="7,0">
                                            <TextBlock Text="{Binding InvertedCount}" FontSize="9"/>
                                        </ContentControl>
                                        <TextBlock Text="{Binding Conclusion2}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Fg}"
                                                   Margin="7,0,0,0" VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{DynamicResource Brush.CardWell}"
                            BorderBrush="{DynamicResource Brush.SepLine}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,13,13" Padding="14,8">
                        <Grid>
                            <TextBlock Text="日期来自原表计划列" Style="{StaticResource T.Tiny}"
                                       FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock FontSize="9" FontFamily="{DynamicResource Font.Mono}"
                                       Foreground="{DynamicResource Brush.Muted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Run Text="{Binding TextPlanCount, Mode=OneWay}"/><Run Text=" 处文本未计入"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 阶段填写率 / 照片分布 / 本期结论 ==================== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.12*"/>
            </Grid.ColumnDefinitions>

            <!-- 阶段填写率 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,0">
                <StackPanel>
                    <Grid Margin="0,0,0,9">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" CornerRadius="6"
                                    Background="{DynamicResource Brush.PrimaryDim}">
                                <TextBlock Text="▥" FontSize="11"
                                           Foreground="{DynamicResource Brush.Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="阶段填写率" FontSize="12.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Fg}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource T.Tiny}" FontSize="9"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Run Text="n="/><Run Text="{Binding TotalIssues, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding StageFills}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Fg}"
                                               VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource Bar.Thin}"
                                                 Height="7" Maximum="100"
                                                 Value="{Binding OwnerPercent, Mode=OneWay}"
                                                 VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Grid.Column="2" FontSize="9.5"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Run Text="{Binding OwnerFilled, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Total, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" Text="{Binding Badge}" FontSize="8.5"
                                               HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BadgeKind}" Value="on">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BadgeKind}" Value="ok">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding DesignStageDetail}" Style="{StaticResource T.Tiny}"
                               FontSize="9.5" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- 照片分布 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,0">
                <StackPanel>
                    <Grid Margin="0,0,0,9">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" CornerRadius="6"
                                    Background="{DynamicResource Brush.PrimaryDim}">
                                <TextBlock Text="▣" FontSize="11"
                                           Foreground="{DynamicResource Brush.Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="照片分布" FontSize="12.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Fg}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ContentControl Style="{StaticResource Chip}" Tag="ok"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        MinHeight="17" Padding="7,0">
                            <TextBlock FontSize="9">
                                <Run Text="{Binding PhotoCount, Mode=OneWay}"/><Run Text=" 张"/>
                            </TextBlock>
                        </ContentControl>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PhotoBuckets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="9.5"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               Foreground="{DynamicResource Brush.Fg}"
                                               VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource Bar.Thin}"
                                                 Height="7" Maximum="100"
                                                 Value="{Binding Ratio, Mode=OneWay}"
                                                 VerticalAlignment="Center" Margin="0,0,9,0"
                                                 Foreground="{DynamicResource Brush.Accent}"/>
                                    <TextBlock Grid.Column="2" FontSize="9.5"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Run Text="{Binding Count, Mode=OneWay}"/><Run Text=" 张 · "/><Run Text="{Binding IssueCount, Mode=OneWay}"/><Run Text=" 条"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 合计行 -->
                    <Border BorderBrush="{DynamicResource Brush.SepLine}" BorderThickness="0,1,0,0"
                            Padding="0,2,0,0" Margin="0,2,0,0">
                        <Grid Height="25" DataContext="{Binding PhotoTotalRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="9.5"
                                       FontFamily="{DynamicResource Font.Mono}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Fg}"
                                       VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Style="{StaticResource Bar.Thin}"
                                         Height="7" Maximum="100" Value="{Binding Ratio, Mode=OneWay}"
                                         VerticalAlignment="Center" Margin="0,0,9,0"
                                         Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock Grid.Column="2" FontSize="9.5"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       Foreground="{DynamicResource Brush.Muted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Run Text="{Binding Count, Mode=OneWay}"/><Run Text=" 张 · "/><Run Text="{Binding IssueCount, Mode=OneWay}"/><Run Text=" 条"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding PhotoFooter}" Style="{StaticResource T.Tiny}"
                               FontSize="9.5" Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="15"/>
                </StackPanel>
            </Border>

            <!-- 本期结论 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,14,4">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" CornerRadius="6"
                                    Background="{DynamicResource Brush.PrimaryDim}">
                                <TextBlock Text="✎" FontSize="11"
                                           Foreground="{DynamicResource Brush.Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="本期结论" FontSize="12.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Fg}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ContentControl Style="{StaticResource Chip}" Tag="ok"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        MinHeight="17" Padding="7,0">
                            <TextBlock Text="可直接汇报" FontSize="9"/>
                        </ContentControl>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="14,8,14,8">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="16" Height="16" CornerRadius="8" VerticalAlignment="Top"
                                    Background="{DynamicResource Brush.PrimaryDim}" Margin="0,1,0,0">
                                <TextBlock Text="1" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Conclusion1}" FontSize="10"
                                       Margin="8,0,0,0" TextWrapping="Wrap" LineHeight="16"
                                       Foreground="{DynamicResource Brush.Fg}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="16" Height="16" CornerRadius="8" VerticalAlignment="Top"
                                    Background="{DynamicResource Brush.WarnSoft}" Margin="0,1,0,0">
                                <TextBlock Text="2" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Warn}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Conclusion2}" FontSize="10"
                                       Margin="8,0,0,0" TextWrapping="Wrap" LineHeight="16"
                                       Foreground="{DynamicResource Brush.Fg}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="16" Height="16" CornerRadius="8" VerticalAlignment="Top"
                                    Background="{DynamicResource Brush.PrimaryDim}" Margin="0,1,0,0">
                                <TextBlock Text="3" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Conclusion3}" FontSize="10"
                                       Margin="8,0,0,0" TextWrapping="Wrap" LineHeight="16"
                                       Foreground="{DynamicResource Brush.Fg}"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{DynamicResource Brush.CardWell}"
                            BorderBrush="{DynamicResource Brush.SepLine}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,13,13" Padding="14,7">
                        <Grid>
                            <TextBlock FontSize="9" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Muted}">
                                <Run Text="口径："/><Run Text="{Binding AsOfDay, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="导出结论" Style="{StaticResource Btn.Ghost}" Height="24"
                                    FontSize="10" Padding="9,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding GoExchangeCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
