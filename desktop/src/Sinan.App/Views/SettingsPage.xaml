<UserControl x:Class="Sinan.App.Views.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}">

    <!--
      ============================================================================
      系统设置（设计稿 settings 页）
      左：固定 6 项目录（点击滚动到右侧对应卡片，不做二级折叠）
      右：数据源 / 导入规则 / 提醒与逾期 / 人员与角色 / 移动端配对 / 危险操作 / 关于与许可
      纪律：路径取运行时实际值；未实现的能力（提醒、配对服务、一键清空）如实标注"未启用"，
            不放假二维码、不放假开关。设置即时生效，因此不放"保存设置"按钮。
      ============================================================================
    -->

    <Grid Margin="0,0,12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左：设置目录 ==================== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8"
                VerticalAlignment="Top" Margin="0,0,12,0">
            <ListBox ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSectionItem, Mode=TwoWay}"
                     SelectionChanged="OnSectionChanged"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="设置目录">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            BorderBrush="Transparent" BorderThickness="1"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Brush.RowHover}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Brush.PrimaryDim}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ==================== 右：设置内容 ==================== -->
        <ScrollViewer Grid.Column="1" x:Name="ContentScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">

                <!-- ========== 数据与备份 ========== -->
                <Border x:Name="SectionData" Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <Grid Margin="14,12,14,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="6"
                                        Background="{DynamicResource Brush.PrimaryDim}">
                                    <TextBlock Text="▤" FontSize="12"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="数据源" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ContentControl Style="{StaticResource Chip}" Tag="ok"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            MinHeight="17" Padding="7,0">
                                <TextBlock Text="正常" FontSize="10"/>
                            </ContentControl>
                        </Grid>

                        <StackPanel Margin="14,0,14,12">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="数据库" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DbPath}" FontSize="11"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="打开目录" Style="{StaticResource Btn.Ghost}"
                                        Height="24" FontSize="11" Padding="9,0"
                                        Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding DbPath}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="数据根目录" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DataRoot}" FontSize="11"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="打开目录" Style="{StaticResource Btn.Ghost}"
                                        Height="24" FontSize="11" Padding="9,0"
                                        Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding DataRoot}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="附件目录" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AttachmentsDir}" FontSize="11"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="打开目录" Style="{StaticResource Btn.Ghost}"
                                        Height="24" FontSize="11" Padding="9,0"
                                        Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding AttachmentsDir}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="导入归档" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ArchiveDir}" FontSize="11"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="打开目录" Style="{StaticResource Btn.Ghost}"
                                        Height="24" FontSize="11" Padding="9,0"
                                        Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding ArchiveDir}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="日志" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding LogsDir}" FontSize="11"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="打开目录" Style="{StaticResource Btn.Ghost}"
                                        Height="24" FontSize="11" Padding="9,0"
                                        Command="{Binding OpenLogFileCommand}"/>
                            </Grid>

                            <TextBlock Text="{Binding DataSizeText}" Style="{StaticResource T.Tiny}"
                                       FontSize="10.5" Margin="0,9,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 外观（并入"数据与备份"目录） ========== -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="14,12,14,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="6"
                                        Background="{DynamicResource Brush.PrimaryDim}">
                                    <TextBlock Text="☾" FontSize="12"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="外观" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ContentControl Style="{StaticResource Chip}" Tag="plain"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            MinHeight="17" Padding="7,0">
                                <TextBlock Text="{Binding ThemeLabel}" FontSize="10"/>
                            </ContentControl>
                        </Grid>
                        <Grid Margin="14,0,14,12">
                            <TextBlock Text="主题只替换 ResourceDictionary 索引 0，页面不出现色值。"
                                       Style="{StaticResource T.Tiny}" FontSize="10.5"
                                       VerticalAlignment="Center"/>
                            <Button Content="{Binding ThemeActionLabel}" Style="{StaticResource Btn.Ghost}"
                                    Height="26" FontSize="11.5" Padding="10,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding ToggleThemeCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========== 导入规则 ========== -->
                <Border x:Name="SectionImport" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="14,12,14,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="6"
                                        Background="{DynamicResource Brush.PrimaryDim}">
                                    <TextBlock Text="⇥" FontSize="12"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="导入规则" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="与原表一一对应 · 只读" Style="{StaticResource T.Tiny}"
                                       FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Margin="14,0,14,12">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="匹配主键" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="ID（P7391-001）；ID 缺失时按“机台 + 问题”匹配"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="表头探测" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="自动（前 5 行）· 三行表头与扁平表头都支持"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="“/”语义" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="不适用，跳过该阶段（state=na）"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="空白语义" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="未填写，保留空白（state=not_started）"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="写入前预览" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="强制开启" FontSize="11.5"
                                               Foreground="{DynamicResource Brush.Fg}"
                                               VerticalAlignment="Center"/>
                                    <ContentControl Style="{StaticResource Chip}" Tag="ok" Margin="8,0,0,0"
                                                    MinHeight="16" Padding="7,0">
                                        <TextBlock Text="不可关闭" FontSize="10"/>
                                    </ContentControl>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Hairline}" Margin="0,10,0,8"/>
                            <TextBlock Style="{StaticResource T.Tiny}" FontSize="10.5" TextWrapping="Wrap"
                                       LineHeight="16"
                                       Text="导入规则写死在解析器里，避免不同人用不同口径把同一张表导成两种结果；确需调整时改代码并补回归测试。"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 提醒与逾期 ========== -->
                <Border x:Name="SectionAlert" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="14,12,14,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="6"
                                        Background="{DynamicResource Brush.PrimaryDim}">
                                    <TextBlock Text="◷" FontSize="12"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="提醒与逾期" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ContentControl Style="{StaticResource Chip}" Tag="warn"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            MinHeight="17" Padding="7,0">
                                <TextBlock Text="MVP 未启用" FontSize="10"/>
                            </ContentControl>
                        </Grid>

                        <StackPanel Margin="14,0,14,12">
                            <TextBlock Style="{StaticResource T.Tiny}" FontSize="11" TextWrapping="Wrap"
                                       LineHeight="17"
                                       Text="MVP 暂不做系统级弹窗提醒与每日摘要；逾期与倒挂在台账、工作台、总览里实时标出，打开软件就能看到。"/>
                            <Border Style="{StaticResource Hairline}" Margin="0,10,0,8"/>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="逾期判定" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="只用语义计划日；“/”、文字计划、空白都不参与"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.Fg}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前逾期" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" FontSize="11.5" FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Warn}">
                                    <Run Text="{Binding OverdueCount, Mode=OneWay}"/><Run Text=" 条"/>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前倒挂" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" FontSize="11.5" FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Ng}">
                                    <Run Text="{Binding InvertedCount, Mode=OneWay}"/><Run Text=" 条"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 人员与角色 ========== -->
                <Border x:Name="SectionPeople" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="14,12,14,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="6"
                                        Background="{DynamicResource Brush.PrimaryDim}">
                                    <TextBlock Text="◉" FontSize="12"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="当前账号" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ContentControl Style="{StaticResource Chip}" Tag="on"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            MinHeight="17" Padding="7,0">
                                <TextBlock Text="{Binding CurrentUserRole}" FontSize="10"/>
                            </ContentControl>
                        </Grid>
                        <StackPanel Margin="14,0,14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="姓名" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentUserName}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="工号" Style="{StaticResource T.Tiny}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentUserEmployeeNo}"
                                           FontSize="11.5" FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="14,12,14,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="6"
                                        Background="{DynamicResource Brush.PrimaryDim}">
                                    <TextBlock Text="▥" FontSize="12"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="在册人员" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock FontSize="10" FontFamily="{DynamicResource Font.Mono}"
                                       Foreground="{DynamicResource Brush.Muted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Run Text="{Binding UserCount, Mode=OneWay}"/><Run Text=" 人"/>
                            </TextBlock>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Users}" Margin="14,0,14,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.SepLine}"
                                            BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource Dot}" Tag="ok"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Fg}"
                                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding EmployeeNo}" FontSize="10.5"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           Foreground="{DynamicResource Brush.Muted}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding RoleDisplay}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.Muted}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="人员停用只置 active=0，历史记录中的名字不会变成未知。"
                                   Style="{StaticResource T.Tiny}" FontSize="10.5" TextWrapping="Wrap"
                                   Margin="14,0,14,12"/>
                    </StackPanel>
                </Border>

                <!-- ========== 移动端配对 ========== -->
                <Border x:Name="SectionMobile" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="14,12,14,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="6"
                                        Background="{DynamicResource Brush.PrimaryDim}">
                                    <TextBlock Text="▣" FontSize="12"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="移动端配对" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ContentControl Style="{StaticResource Chip}" Tag="warn"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            MinHeight="17" Padding="7,0">
                                <TextBlock Text="未启用" FontSize="10"/>
                            </ContentControl>
                        </Grid>

                        <Grid Margin="14,0,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding SyncStatusText}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Fg}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SyncPortDisplay}" Style="{StaticResource T.Tiny}"
                                           FontSize="10.5" Margin="0,5,0,0"/>
                                <TextBlock Style="{StaticResource T.Tiny}" FontSize="10.5" Margin="0,7,0,0"
                                           TextWrapping="Wrap" LineHeight="16"
                                           Text="配对后手机可离线记录，回到局域网按队列补传；照片默认压缩到长边 1600px。桌面端是主库，手机端只做离线副本，不做双向合并。"/>
                            </StackPanel>

                            <!-- 未启用时给占位框，不画假二维码 -->
                            <Border Grid.Column="1" Width="112" Height="112" CornerRadius="10"
                                    Background="{DynamicResource Brush.CardWell}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" VerticalAlignment="Top">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="▦" FontSize="24"
                                               Foreground="{DynamicResource Brush.Faint}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="配对服务" FontSize="10.5"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    <TextBlock Text="未启用" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Warn}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========== 危险操作 ========== -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Ng}"
                                CornerRadius="19,0,0,19"/>
                        <StackPanel Grid.Column="1">
                            <Grid Margin="11,12,14,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" FontSize="12"
                                               Foreground="{DynamicResource Brush.Ng}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="危险操作" FontSize="13.5" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Fg}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <ContentControl Style="{StaticResource Chip}" Tag="ng"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                MinHeight="17" Padding="7,0">
                                    <TextBlock Text="不可撤销" FontSize="10"/>
                                </ContentControl>
                            </Grid>
                            <Grid Margin="11,0,14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource T.Tiny}" FontSize="10.5" TextWrapping="Wrap"
                                           LineHeight="16" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Text="MVP 不提供一键清空台账：台账与修改留痕要可追溯。确需重置本机演示数据时，关闭软件后删除数据目录下的 sinan.db，下次启动会重新建表并种入 36 条演示数据。"/>
                                <Button Grid.Column="1" Content="打开数据目录" Style="{StaticResource Btn.Ghost}"
                                        Height="26" FontSize="11" Padding="10,0"
                                        BorderBrush="{DynamicResource Brush.NgLine}"
                                        Foreground="{DynamicResource Brush.Ng}"
                                        VerticalAlignment="Center"
                                        Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding DataRoot}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========== 关于与许可 ========== -->
                <Border x:Name="SectionAbout" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="14,12,14,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="6"
                                        Background="{DynamicResource Brush.PrimaryDim}">
                                    <TextBlock Text="ⓘ" FontSize="12"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="关于与许可" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ContentControl Style="{StaticResource Chip}" Tag="ok"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            MinHeight="17" Padding="7,0">
                                <TextBlock Text="本机单机版" FontSize="10"/>
                            </ContentControl>
                        </Grid>

                        <StackPanel Margin="14,0,14,12">
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="产品" Style="{StaticResource T.Tiny}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="司南 · 安装调试问题闭环系统"
                                           FontSize="12" Foreground="{DynamicResource Brush.Fg}"/>
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="演示项目" Style="{StaticResource T.Tiny}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="P7391 · P7391-01 / 02 / 03 · 待确认 1 台"
                                           FontSize="11.5" FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Fg}"/>
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="数据规模" Style="{StaticResource T.Tiny}" FontSize="11"/>
                                <TextBlock Grid.Column="1" FontSize="11.5"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Fg}">
                                    <Run Text="{Binding IssueCount, Mode=OneWay}"/><Run Text=" 条问题 · "/><Run Text="{Binding MachineCount, Mode=OneWay}"/><Run Text=" 台设备 · "/><Run Text="{Binding UserCount, Mode=OneWay}"/><Run Text=" 位在册人员"/>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="版本" Style="{StaticResource T.Tiny}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="{Binding SchemaVersion}"
                                           FontSize="11.5" FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Fg}"/>
                            </Grid>

                            <Border Background="{DynamicResource Brush.PrimaryDim}"
                                    BorderBrush="{DynamicResource Brush.PrimaryLine}" BorderThickness="1"
                                    CornerRadius="10" Padding="11,9" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource T.Tiny}" FontSize="10.5" TextWrapping="Wrap"
                                           LineHeight="16"
                                           Text="演示数据全部虚构：项目号 P7391、人员“张工/李工/王工…”均为角色化假名，不含任何客户真实项目、机台或问题内容。照片为演示元数据。"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource T.Tiny}" FontSize="10.5" Margin="2,10,0,0"
                           Text="设置即时生效；本页所有路径取运行时实际值，可用环境变量 SINAN_DATA_DIR 覆盖数据根目录。"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
