<UserControl x:Class="Sinan.App.Views.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">

            <Border Style="{StaticResource Card}" Padding="18,14">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="系统设置" Style="{StaticResource T.H2}" FontSize="16"/>
                        <TextBlock Text="·" Style="{StaticResource T.Tiny}" Margin="8,0"/>
                        <TextBlock Text="本地数据 · 账号 · 主题 · 关于" Style="{StaticResource T.Small}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="设置只影响本机，不写回 Excel" Style="{StaticResource T.Tiny}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">

                    <!-- 当前账号 -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="当前账号" Style="{StaticResource T.H2}" FontSize="15"/>

                            <Border Background="{DynamicResource Brush.CardWell}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="14" Padding="14,12" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="44" Height="44" CornerRadius="22"
                                            Background="{DynamicResource Brush.AccentSoft}">
                                        <TextBlock Text="{Binding CurrentUserName}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentUserName}" Style="{StaticResource T.Value}"
                                                   FontSize="13.5"/>
                                        <TextBlock Style="{StaticResource T.Tiny}" FontSize="10" Margin="0,2,0,0">
                                            <Run Text="{Binding CurrentUserRole, Mode=OneWay}"/><Run Text=" · 工号 "/><Run Text="{Binding CurrentUserEmployeeNo, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="在册人员" Style="{StaticResource T.Tiny}" FontSize="10"
                                       Margin="2,12,0,6"/>
                            <ItemsControl ItemsSource="{Binding Users}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.SepLine}"
                                                BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource Dot}" Tag="ok"/>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Small}"
                                                               FontSize="11.5" Margin="7,0,0,0"/>
                                                    <TextBlock Text="{Binding EmployeeNo}" Style="{StaticResource T.Mono}"
                                                               FontSize="9.5" Margin="8,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding RoleDisplay}" Style="{StaticResource T.Tiny}"
                                                           FontSize="10" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="人员停用只置 active=0，历史记录中的名字不会变成未知。"
                                       Style="{StaticResource T.Tiny}" FontSize="9.5" TextWrapping="Wrap"
                                       Margin="2,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 主题 -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="外观" Style="{StaticResource T.H2}" FontSize="15"/>
                            <Grid Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="当前主题" Style="{StaticResource T.Tiny}" FontSize="10"/>
                                    <TextBlock Text="{Binding ThemeLabel}" Style="{StaticResource T.Value}"
                                               FontSize="14" Margin="0,3,0,0"/>
                                    <TextBlock Text="主题只替换 ResourceDictionary 索引 0，页面不出现色值"
                                               Style="{StaticResource T.Tiny}" FontSize="9.5" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Content="{Binding ThemeActionLabel, StringFormat=☾  {0}}"
                                        Style="{StaticResource Btn.Secondary}" Height="32"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Command="{Binding ToggleThemeCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">

                    <!-- 数据位置 -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="本地数据位置" Style="{StaticResource T.H2}" FontSize="15"/>
                                <ContentControl Style="{StaticResource Chip}" Tag="info"
                                                HorizontalAlignment="Right">
                                    <TextBlock Text="断网可用" FontSize="9.5"/>
                                </ContentControl>
                            </Grid>
                            <TextBlock Text="{Binding DataSizeText}" Style="{StaticResource T.Tiny}"
                                       FontSize="10" Margin="0,3,0,10"/>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="数据根目录" Style="{StaticResource T.Tiny}"
                                           FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DataRoot}" Style="{StaticResource T.Mono}"
                                           FontSize="9.5" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="打开" Style="{StaticResource Btn.Ghost}"
                                        Height="22" Padding="0" FontSize="10"
                                        Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding DataRoot}"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="数据库" Style="{StaticResource T.Tiny}"
                                           FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DbPath}" Style="{StaticResource T.Mono}"
                                           FontSize="9.5" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="打开" Style="{StaticResource Btn.Ghost}"
                                        Height="22" Padding="0" FontSize="10"
                                        Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding DbPath}"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="附件" Style="{StaticResource T.Tiny}"
                                           FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AttachmentsDir}" Style="{StaticResource T.Mono}"
                                           FontSize="9.5" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="打开" Style="{StaticResource Btn.Ghost}"
                                        Height="22" Padding="0" FontSize="10"
                                        Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding AttachmentsDir}"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="导入归档" Style="{StaticResource T.Tiny}"
                                           FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ArchiveDir}" Style="{StaticResource T.Mono}"
                                           FontSize="9.5" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="打开" Style="{StaticResource Btn.Ghost}"
                                        Height="22" Padding="0" FontSize="10"
                                        Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding ArchiveDir}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="日志" Style="{StaticResource T.Tiny}"
                                           FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding LogsDir}" Style="{StaticResource T.Mono}"
                                           FontSize="9.5" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="打开" Style="{StaticResource Btn.Ghost}"
                                        Height="22" Padding="0" FontSize="10"
                                        Command="{Binding OpenLogFileCommand}"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}" Margin="0,10,0,8"/>
                            <TextBlock Style="{StaticResource T.Tiny}" FontSize="9.5" TextWrapping="Wrap"
                                       Text="运行时数据不放在仓库；可用环境变量 SINAN_DATA_DIR 覆盖根目录。界面路径全部取实际值，不抄示意路径。"/>
                        </StackPanel>
                    </Border>

                    <!-- 关于 -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="关于" Style="{StaticResource T.H2}" FontSize="15"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="产品" Style="{StaticResource T.Tiny}"
                                           FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="司南 · 安装调试问题闭环系统"
                                           Style="{StaticResource T.Value}" FontSize="11.5"/>
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="演示项目" Style="{StaticResource T.Tiny}"
                                           FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="P7391 · P7391-01 / 02 / 03 · 待确认 1 台"
                                           Style="{StaticResource T.Mono}" FontSize="10.5"/>
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="数据规模" Style="{StaticResource T.Tiny}"
                                           FontSize="10"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource T.Mono}" FontSize="10.5">
                                    <Run Text="{Binding IssueCount, Mode=OneWay}"/><Run Text=" 条问题 · "/><Run Text="{Binding MachineCount, Mode=OneWay}"/><Run Text=" 台机台 · "/><Run Text="{Binding UserCount, Mode=OneWay}"/><Run Text=" 位在册人员"/>
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="版本" Style="{StaticResource T.Tiny}"
                                           FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="{Binding SchemaVersion}"
                                           Style="{StaticResource T.Mono}" FontSize="10.5"/>
                            </Grid>

                            <Border Background="{DynamicResource Brush.PrimaryDim}"
                                    BorderBrush="{DynamicResource Brush.PrimaryLine}" BorderThickness="1"
                                    CornerRadius="10" Padding="11,9" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource T.Tiny}" FontSize="9.5" TextWrapping="Wrap"
                                           Text="演示数据全部虚构：项目号 P7391、人员“张工/李工/王工…”均为角色化假名，不含任何客户真实项目、机台或问题内容。照片为演示元数据。"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
