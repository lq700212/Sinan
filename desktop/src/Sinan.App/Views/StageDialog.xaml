<ui:ChromeDialogWindow x:Class="Sinan.App.Views.StageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
        Title="更新阶段"
        Subtitle="{Binding HeaderSubtitle}"
        TitleIconChar="◷"
        Width="620" Height="660"
        Resizeable="False"
        CaptionHeight="40"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}"
        Foreground="{DynamicResource Brush.Fg}">

    <!--
      ============================================================================
      更新阶段弹窗（设计稿 dlg-stage）
      一个窗口完成：选阶段 → 阶段结果 → 实际完成日 → 责任人 → 调整计划日 → 变更原因。
      三条纪律直接落在界面上：
        1) 改计划日 → "变更原因"变必填并在提示里说明（审计要能回答为什么改）；
        2) 倒挂只告警不阻断（红条出现时保存按钮仍然可点）；
        3) `/` = 不适用，空白 = 未填，两者不混。
      ============================================================================
    -->

    <Grid Margin="24,14,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 阶段切换：设计稿 .segline，当前段青底青字 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <ItemsControl ItemsSource="{Binding StageTabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Height="30" Padding="14,0" Margin="0,0,6,0"
                                FontSize="12"
                                AutomationProperties.Name="{Binding Label, StringFormat=切换到 {0}}"
                                Command="{Binding DataContext.SelectStageCommand,
                                          RelativeSource={RelativeSource AncestorType=ui:ChromeDialogWindow}}"
                                CommandParameter="{Binding Code}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.PrimaryDim}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding CurrentLabel, StringFormat=正在填写：{0}}" Style="{StaticResource T.Tiny}"
                       FontSize="10" Margin="2,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">

                <!-- 阶段结果：四选一（设计稿三个 chk，四个状态都要能落到界面） -->
                <TextBlock Text="阶段结果" Style="{StaticResource T.Label}" Margin="2,0,0,6"/>
                <ListBox ItemsSource="{Binding StateOptions}"
                         SelectedItem="{Binding SelectedStateOption, Mode=TwoWay}"
                         Background="{DynamicResource Brush.CardWell}"
                         BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                         Padding="4" Margin="0,0,0,14"
                         AutomationProperties.AutomationId="StageStateList"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <!-- 列表项必须给可访问名：默认名是类型名（Sinan.App.ViewModels.StageStateOption），
                                 读屏与自动化都分不清四个状态，只能靠子元素文字碰运气。 -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Brush.HoverSoft}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Brush.PrimaryDim}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Brush.Primary}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" FontSize="12"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 实际完成日 + 责任人 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="实际完成日" Style="{StaticResource T.Label}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource Input.Text}" Height="34"
                                 AutomationProperties.AutomationId="StageActualBox"
                                 FontFamily="{DynamicResource Font.Mono}"
                                 Text="{Binding ActualDateRaw, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="填 2026-11-05 这种日期；留空表示未完成"/>
                        <TextBlock Text="{Binding ActualHint}" Style="{StaticResource T.Tiny}" FontSize="9.5"
                                   Margin="2,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="责任人（原文，可多人用 /）" Style="{StaticResource T.Label}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource Input.Text}" Height="34"
                                 AutomationProperties.AutomationId="StageOwnerBox"
                                 Text="{Binding OwnerText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- 调整计划日 -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="调整计划日（原文）" Style="{StaticResource T.Label}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource Input.Text}" Height="34"
                                 AutomationProperties.AutomationId="StageDueBox"
                                 FontFamily="{DynamicResource Font.Mono}"
                                 Text="{Binding DueRaw, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding DueHint}" Style="{StaticResource T.Tiny}" FontSize="9.5"
                                   Margin="2,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding PlanChangedHint}" Style="{StaticResource T.Tiny}" FontSize="9.5"
                                   TextWrapping="Wrap" Margin="2,0,0,5"/>
                        <Border HorizontalAlignment="Left" Padding="8,2" CornerRadius="8"
                                BorderThickness="1"
                                Background="{DynamicResource Brush.CardWell}"
                                BorderBrush="{DynamicResource Brush.Border}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.CardWell}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedReason}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarnLine}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding PlanChangedTag}" FontSize="9.5"
                                       Foreground="{DynamicResource Brush.Muted}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 变更原因 -->
                <StackPanel Orientation="Horizontal" Margin="2,14,0,6">
                    <TextBlock Text="变更原因" Style="{StaticResource T.Label}"/>
                    <TextBlock Text="（改计划日必填）" Style="{StaticResource T.Tiny}" FontSize="9.5"
                               Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Muted}"/>
                </StackPanel>
                <TextBox Style="{StaticResource Input.Text}" Height="56"
                         AutomationProperties.AutomationId="StageReasonBox"
                         Text="{Binding ChangeReason, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Padding="10,8"
                         VerticalContentAlignment="Top"
                         ToolTip="例如：与线体联调窗口对齐、客户图纸延后"/>

                <!-- 阶段备注 -->
                <TextBlock Text="阶段备注" Style="{StaticResource T.Label}" Margin="2,14,0,6"/>
                <TextBox Style="{StaticResource Input.Text}" Height="56"
                         AutomationProperties.AutomationId="StageRemarkBox"
                         Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Padding="10,8"
                         VerticalContentAlignment="Top"/>
            </StackPanel>
        </ScrollViewer>

        <!--
          底部常驻区（设计稿 dlg-stage 的 .dlg-hint 就在表单下方常驻）：
          倒挂提示与就地错误都必须"保存前一定看得见"，放滚动区里会被备注框挤到最底部，
          用户不滚到底就点了保存，然后什么也没发生——这是最糟的交互。
        -->
        <StackPanel Grid.Row="2">
            <Border Margin="0,12,0,0" Padding="11,9" CornerRadius="10"
                    Background="{DynamicResource Brush.NgSoft}"
                    BorderBrush="{DynamicResource Brush.NgLine}" BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource TrueToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource Brush.Ng}"/>
            </Border>

            <Border Margin="0,10,0,0" Padding="11,9" CornerRadius="10"
                    Background="{DynamicResource Brush.NgSoft}"
                    BorderBrush="{DynamicResource Brush.NgLine}" BorderThickness="1"
                    Visibility="{Binding HasInvertedHint, Converter={StaticResource TrueToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Chip}" Tag="ng" Margin="0,0,8,0"
                                    VerticalAlignment="Top">
                        <TextBlock Text="仍倒挂" FontSize="9.5"/>
                    </ContentControl>
                    <TextBlock Text="{Binding InvertedHint}" TextWrapping="Wrap" MaxWidth="460"
                               FontSize="11" Foreground="{DynamicResource Brush.Ng}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 底部操作 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="保存后写审计：修改人 + 时间 + 原因" Style="{StaticResource T.Tiny}"
                       FontSize="9.5" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Btn.Ghost}" Height="34" Width="82"
                        AutomationProperties.AutomationId="StageCancelButton"
                        Command="{Binding CancelCommand}"/>
                <Button Content="保存并留痕" Style="{StaticResource Btn.Primary}" Height="34" Width="112"
                        Margin="10,0,0,0"
                        AutomationProperties.AutomationId="StageSaveButton"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:ChromeDialogWindow>
