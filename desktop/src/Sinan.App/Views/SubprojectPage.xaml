<UserControl x:Class="Sinan.App.Views.SubprojectPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}">

    <!--
      ============================================================================
      分项目 · 设备问题预览（设计稿 p1 · data-page="project"）
      结构对照设计稿：
        面包屑 → 分项目头卡（印章 + 名称 + 4 项 meta + 倒挂/导出）
        → 左右两栏：左"设备清单"（band 卡头 + 表格 + 卡底），
                    右"选中设备问题点"（band 卡头 + 摘要条 + 问题卡 + 照片条 + 卡底）
      设计取舍：
        - 设备表用 ListBox 自绘行而不是 GridView：设计稿列宽是"128/108/70/剩余"，
          GridView 最后一列不能写 *，1440 下会留一条空列；自绘 Grid 能铺满且
          选中行可以带左侧 2px 主色条（设计稿 .dev-tbl tr.on 的 inset 阴影）。
        - 问题卡只挂"最需要处理的一个"标签（倒挂 > 计划文本 > 设计未填），
          照片数单独一枚绿标，与设计稿三张演示卡的信息密度一致。
        - 照片是演示占位（历史 Excel 无附件），标题与卡底都必须带"演示"字样。
      ============================================================================
    -->

    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 面包屑（.crumbbar） ==================== -->
        <Grid Grid.Row="0" Margin="2,0,2,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="P7391 总项目" Style="{StaticResource T.Tiny}" FontSize="11.5"
                           Foreground="{DynamicResource Brush.Muted}" Cursor="Hand"/>
                <TextBlock Text="›" Style="{StaticResource T.Tiny}" FontSize="11.5" Margin="6,0"
                           Foreground="{DynamicResource Brush.Faint}"/>
                <TextBlock Text="{Binding Code}" Style="{StaticResource T.Tiny}" FontSize="11.5"
                           FontWeight="Bold" FontFamily="{DynamicResource Font.Mono}"
                           Foreground="{DynamicResource Brush.Fg}"/>
                <TextBlock Text="›" Style="{StaticResource T.Tiny}" FontSize="11.5" Margin="6,0"
                           Foreground="{DynamicResource Brush.Faint}"/>
                <TextBlock Text="设备问题预览" Style="{StaticResource T.Tiny}" FontSize="11.5"/>
            </StackPanel>
            <TextBlock Text="{Binding MachineRange}" Style="{StaticResource T.Tiny}" FontSize="11"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- ==================== 分项目头卡（.proj-hero） ==================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,10" Margin="0,0,0,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 印章：设计稿本页把 52 覆盖成 40×40 / 15px，只放分项目序号 -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                        Background="{DynamicResource Brush.PrimaryGrad}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SealText}" FontFamily="{DynamicResource Font.Mono}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.OnPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Fg}" VerticalAlignment="Center"/>
                        <ContentControl Margin="8,0,0,0">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                                    <Setter Property="Tag" Value="{Binding StatusChipTag}"/>
                                </Style>
                            </ContentControl.Style>
                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11"/>
                        </ContentControl>
                    </StackPanel>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource T.Tiny}"
                               FontSize="11.5" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource Chip}" Tag="warn" Margin="0,0,8,0"
                                    Visibility="{Binding HasInverted, Converter={StaticResource TrueToVisibility}}">
                        <TextBlock Text="{Binding InvertedText}" FontSize="11"/>
                    </ContentControl>
                    <Button Content="导出本分项目" Style="{StaticResource Btn.Ghost}" Height="28"
                            FontSize="12" Command="{Binding ExportCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 左右两栏（.dev-layout） ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="378"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左：设备清单 ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 卡头 band：浅色带底 + 底边线，顶角与卡片同心 -->
                    <Border Grid.Row="0" Background="{DynamicResource Brush.CardWell}"
                            BorderBrush="{DynamicResource Brush.SepLine}" BorderThickness="0,0,0,1"
                            CornerRadius="18,18,0,0" Padding="14,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="6"
                                        Background="{DynamicResource Brush.PrimaryDim}">
                                    <TextBlock Text="▤" FontSize="11"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="设备清单" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center" Margin="7,0,0,0"/>
                                <ContentControl Style="{StaticResource Chip}" Tag="plain" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding MachineCount, StringFormat={}{0} 台}" FontSize="10.5"/>
                                </ContentControl>
                            </StackPanel>
                            <TextBlock Text="点行查看该设备问题点" Style="{StaticResource T.Tiny}" FontSize="10.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 自绘表头：列宽与行模板严格一致（128 / 108 / 70 / 剩余） -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource Brush.TheadBg}"
                                BorderBrush="{DynamicResource Brush.SepLine}" BorderThickness="0,0,0,1">
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="机台号" Margin="14,0,0,0"
                                           Style="{StaticResource T.Tiny}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.TheadFg}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="问题 / 倒挂" Margin="10,0,0,0"
                                           Style="{StaticResource T.Tiny}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.TheadFg}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="照片" Margin="10,0,0,0"
                                           Style="{StaticResource T.Tiny}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.TheadFg}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="装配责任人" Margin="10,0,0,0"
                                           Style="{StaticResource T.Tiny}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.TheadFg}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1" x:Name="MachineTable" Margin="0"
                                 AutomationProperties.AutomationId="MachineTable"
                                 ItemsSource="{Binding Machines}"
                                 SelectedItem="{Binding SelectedMachine, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FocusVisualStyle="{x:Null}">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Background="Transparent" Padding="0"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemContainerStyle>
                                <!-- 行：默认透明；悬停浅底；选中主色柔底 + 左侧 2px 主色条。
                                     无障碍名绑机台号，自动化与读屏能定位到具体设备。 -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Code}"/>
                                    <Setter Property="AutomationProperties.AutomationId"
                                            Value="{Binding Code, StringFormat=machine-{0}}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent"
                                                        BorderBrush="{DynamicResource Brush.SepLine}"
                                                        BorderThickness="0,0,0,1" Padding="0">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource Brush.RowHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource Brush.PrimaryDim}"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="{DynamicResource Brush.Primary}"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness"
                                                                Value="2,0,0,1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="33">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128"/>
                                            <ColumnDefinition Width="108"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Code}" Margin="14,0,0,0"
                                                   FontFamily="{DynamicResource Font.Mono}" FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Fg}"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IssueCount}" FontSize="13"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Fg}"/>
                                            <ContentControl Style="{StaticResource Chip}" Tag="ng"
                                                            Margin="6,0,0,0" MinHeight="16" Padding="6,0"
                                                            Visibility="{Binding HasInverted, Converter={StaticResource TrueToVisibility}}">
                                                <TextBlock Text="{Binding InvertedCount}" FontSize="10"/>
                                            </ContentControl>
                                        </StackPanel>

                                        <Grid Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="—" Foreground="{DynamicResource Brush.Faint}"
                                                       FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPhoto}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ContentControl MinHeight="16" Padding="6,0"
                                                            HorizontalAlignment="Left">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                                                        <Setter Property="Tag" Value="ok"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPhoto}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                                <TextBlock Text="{Binding PhotoCount}" FontSize="10"/>
                                            </ContentControl>
                                        </Grid>

                                        <TextBlock Grid.Column="3" Text="{Binding AssemblyOwnersDisplay}"
                                                   Margin="10,0,14,0" FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.Muted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding AssemblyOwners}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 卡底（.card-f）：与卡片底角同心 -->
                    <Border Grid.Row="2" Background="{DynamicResource Brush.CardWell}"
                            BorderBrush="{DynamicResource Brush.SepLine}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,13,13" Padding="14,7">
                        <Grid>
                            <TextBlock Style="{StaticResource T.Tiny}" FontSize="11" VerticalAlignment="Center">
                                <Run Text="{Binding MachineCount, Mode=OneWay}"/><Run Text=" 台 · "/>
                                <Run Text="{Binding IssueCount, Mode=OneWay}"/><Run Text=" 条问题"/>
                            </TextBlock>
                            <TextBlock Text="{Binding PhotoNote}" Style="{StaticResource T.Tiny}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== 右：选中设备的问题点（.qpanel） ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 卡头 band：机台号 + 条数 + 倒挂 -->
                    <Border Grid.Row="0" Background="{DynamicResource Brush.CardWell}"
                            BorderBrush="{DynamicResource Brush.SepLine}" BorderThickness="0,0,0,1"
                            CornerRadius="18,18,0,0" Padding="14,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="6"
                                        Background="{DynamicResource Brush.PrimaryDim}">
                                    <TextBlock Text="◉" FontSize="11"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedTitle}" FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center" Margin="7,0,0,0"/>
                                <ContentControl Style="{StaticResource Chip}" Tag="plain" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding SelectedIssueCountText}" FontSize="10.5"/>
                                </ContentControl>
                            </StackPanel>
                            <ContentControl Style="{StaticResource Chip}" Tag="warn"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding SelectedHasInverted, Converter={StaticResource TrueToVisibility}}">
                                <TextBlock Text="{Binding SelectedInvertedText}" FontSize="10.5"/>
                            </ContentControl>
                        </Grid>
                    </Border>

                    <!-- 摘要条（.qpanel-h）：装配责任人 + 照片数 -->
                    <Border Grid.Row="1" Background="{DynamicResource Brush.CardWell}"
                            BorderBrush="{DynamicResource Brush.SepLine}" BorderThickness="0,0,0,1"
                            Padding="14,7">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="装配责任人" Style="{StaticResource T.Tiny}" FontSize="10.5"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedOwnerValue}" FontSize="11.5"
                                           FontWeight="SemiBold" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedPhotoText}" Style="{StaticResource T.Tiny}"
                                       FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 问题卡 + 照片条（.qpanel-b） -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0">
                        <StackPanel Margin="9,9,9,9">

                            <ItemsControl ItemsSource="{Binding SelectedIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 问题卡：hover 换主色边框；点击整卡进详情（.qitem） -->
                                        <Border Margin="0,0,0,7" Padding="9,8" CornerRadius="8"
                                                Cursor="Hand" ToolTip="打开问题详情">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenIssueCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding Id}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource Brush.Panel}"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource Brush.Border}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource Brush.PrimaryLine}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <!-- 第一行：问题号 + 主标签 + 责任人 + 照片 -->
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CodeText}"
                                                                   FontFamily="{DynamicResource Font.Mono}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource Brush.Muted}"
                                                                   VerticalAlignment="Center"/>
                                                        <ContentControl Style="{StaticResource Chip}"
                                                                        Tag="{Binding BadgeTag}"
                                                                        Margin="6,0,0,0" MinHeight="16" Padding="6,0"
                                                                        Visibility="{Binding HasBadge, Converter={StaticResource TrueToVisibility}}">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="10"/>
                                                        </ContentControl>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding OwnerText}" FontSize="10.5"
                                                                   Foreground="{DynamicResource Brush.Muted}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                        <ContentControl Style="{StaticResource Chip}" Tag="ok"
                                                                        Margin="6,0,0,0" MinHeight="16" Padding="6,0"
                                                                        Visibility="{Binding HasPhoto, Converter={StaticResource TrueToVisibility}}">
                                                            <TextBlock Text="{Binding PhotoText}" FontSize="10"/>
                                                        </ContentControl>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.Fg}"
                                                           TextWrapping="Wrap" LineHeight="16"
                                                           Margin="0,3,0,0"/>

                                                <TextBlock Text="{Binding SolutionLine}" FontSize="10.5"
                                                           Foreground="{DynamicResource Brush.Muted}"
                                                           TextWrapping="Wrap" LineHeight="14"
                                                           Margin="0,2,0,0"/>

                                                <!-- 计划行：只有填过计划才出现，避免每条都多一行破折号 -->
                                                <TextBlock Text="{Binding PlanLine}" FontSize="10"
                                                           Foreground="{DynamicResource Brush.Muted}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding HasPlanLine, Converter={StaticResource TrueToVisibility}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 空状态：这台设备没问题 / 没选设备 -->
                            <Border Padding="14,20" CornerRadius="8"
                                    Visibility="{Binding SelectedHasIssues, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedEmptyHint}" Style="{StaticResource T.Tiny}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </Border>

                            <!-- 照片条（演示占位） -->
                            <StackPanel Margin="0,2,0,0"
                                        Visibility="{Binding SelectedHasPhotos, Converter={StaticResource TrueToVisibility}}">
                                <Grid Margin="1,0,1,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="现场照片" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Muted}"/>
                                        <TextBlock Text="{Binding SelectedPhotoCountText}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.Muted}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="演示占位 · 历史 Excel 无附件"
                                               FontSize="9.5" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource Brush.Faint}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SelectedPhotos}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 演示照片占位：设计稿 .photo-thumb 是深色渐变（#46545E→#1B242B），
                                                 不随主题走；白字 + "演示"角标保证不会被误认为现场真照片。 -->
                                            <Border Width="104" Height="84" Margin="0,0,6,6" CornerRadius="7"
                                                    BorderBrush="#33FFFFFF" BorderThickness="1">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#46545E" Offset="0"/>
                                                        <GradientStop Color="#1B242B" Offset="0.55"/>
                                                        <GradientStop Color="#39424A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <TextBlock Text="▣" FontSize="21"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#66FFFFFF"/>
                                                    <ContentControl Style="{StaticResource Chip}" Tag="plain"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top" Margin="3"
                                                                    MinHeight="15" Padding="5,0"
                                                                    Background="#59000000">
                                                        <TextBlock Text="{Binding Index}" FontSize="9"
                                                                   FontFamily="{DynamicResource Font.Mono}"
                                                                   Foreground="White"/>
                                                    </ContentControl>
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                Margin="5,0,0,4">
                                                        <TextBlock Text="{Binding SeqLabel}" FontSize="9"
                                                                   Foreground="#CCFFFFFF"/>
                                                        <TextBlock Text=" · 演示" FontSize="9"
                                                                   Foreground="#99FFFFFF"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 卡底（.card-f） -->
                    <Border Grid.Row="3" Background="{DynamicResource Brush.CardWell}"
                            BorderBrush="{DynamicResource Brush.SepLine}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,13,13" Padding="14,7">
                        <Grid>
                            <TextBlock Text="点左侧设备切换" Style="{StaticResource T.Tiny}" FontSize="10.5"
                                       VerticalAlignment="Center"/>
                            <Button Content="在台账中筛选 →" Style="{StaticResource Btn.Ghost}" Height="24"
                                    FontSize="11" Padding="8,0" HorizontalAlignment="Right"
                                    Command="{Binding OpenIssuesCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
