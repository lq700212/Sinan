<UserControl x:Class="Sinan.App.Views.SubprojectPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Text.Size.Body}">

    <!--
      ============================================================================
      分项目 · 设备问题预览（设计稿 p1 project）
      左侧设备清单表 + 右侧选中设备的问题点面板，同屏不跳页。
      照片全部是演示占位（历史 Excel 无附件），界面必须带"演示值"字样。
      圆角一律走主题 Radius.* 与库内 KxCapsuleBorder，不写死数值。
      ============================================================================
    -->

    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <!-- 面包屑 -->
            <RowDefinition Height="Auto"/>
            <!-- 分项目头卡 -->
            <RowDefinition Height="Auto"/>
            <!-- 左右两栏（撑满剩余高度） -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 面包屑 ==================== -->
        <Grid Grid.Row="0" Margin="2,0,2,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="P7391 总项目" Style="{StaticResource T.Tiny}" FontSize="10.5"
                           Foreground="{DynamicResource Brush.Primary}" Cursor="Hand"/>
                <TextBlock Text="›" Style="{StaticResource T.Tiny}" FontSize="10.5" Margin="6,0"/>
                <TextBlock Text="{Binding Code}" Style="{StaticResource T.Tiny}" FontSize="10.5"
                           FontWeight="SemiBold" FontFamily="{DynamicResource Font.Mono}"
                           Foreground="{DynamicResource Brush.Fg}"/>
                <TextBlock Text="›" Style="{StaticResource T.Tiny}" FontSize="10.5" Margin="6,0"/>
                <TextBlock Text="设备问题预览" Style="{StaticResource T.Tiny}" FontSize="10.5"/>
            </StackPanel>
            <TextBlock Text="{Binding MachineRange}" Style="{StaticResource T.Tiny}" FontSize="10.5"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- ==================== 分项目头卡 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 分项目印章：设计稿 proj-seal 只放分项目序号（01），圆角 12 / 等宽粗体 -->
                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12"
                        Background="{DynamicResource Brush.PrimaryGrad}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SealText}" FontFamily="{DynamicResource Font.Mono}"
                               FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.OnPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Fg}" VerticalAlignment="Center"/>
                        <ContentControl Margin="9,0,0,0">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                                    <Setter Property="Tag" Value="{Binding StatusChipTag}"/>
                                </Style>
                            </ContentControl.Style>
                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10"/>
                        </ContentControl>
                    </StackPanel>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource T.Tiny}"
                               FontSize="10.5" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource Chip}" Tag="ng" Margin="0,0,8,0"
                                    Visibility="{Binding HasInverted, Converter={StaticResource TrueToVisibility}}">
                        <TextBlock Text="{Binding InvertedText}" FontSize="10"/>
                    </ContentControl>
                    <ContentControl Margin="0,0,8,0">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                                <Setter Property="Tag" Value="plain"/>
                            </Style>
                        </ContentControl.Style>
                        <TextBlock Text="{Binding PhotoNote}" FontSize="10"/>
                    </ContentControl>
                    <Button Content="在台账中筛选 →" Style="{StaticResource Btn.Secondary}" Height="30"
                            FontSize="11.5" Command="{Binding OpenIssuesCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 左右两栏 ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="378"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左：设备清单 ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="设备清单" Style="{StaticResource T.H2}" FontSize="15"/>
                            <ContentControl Style="{StaticResource Chip}" Tag="on" Margin="10,0,0,0">
                                <TextBlock Text="{Binding MachineCount, StringFormat={}{0} 台}" FontSize="10"/>
                            </ContentControl>
                        </StackPanel>
                        <TextBlock Text="点行查看该设备问题点" Style="{StaticResource T.Tiny}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <ListView Grid.Row="1" Style="{StaticResource Grid.Table}" Margin="8,0,8,0"
                              ItemsSource="{Binding Machines}"
                              SelectedItem="{Binding SelectedMachine, Mode=TwoWay}">
                        <ListView.ItemContainerStyle>
                            <!-- 行无障碍名绑机台号：默认行名是类型名（十行全同名），
                                 读屏与自动化都定位不到具体设备。 -->
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource Grid.Row}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Code}"/>
                                <Setter Property="AutomationProperties.AutomationId"
                                        Value="{Binding Code, StringFormat=machine-{0}}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="机台号" Width="132"
                                                HeaderContainerStyle="{StaticResource Grid.Header}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Code}" Margin="10,0,0,0"
                                                       FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Fg}"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="问题 / 倒挂" Width="112"
                                                HeaderContainerStyle="{StaticResource Grid.Header}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IssueCount}" FontSize="12.5"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.Fg}"/>
                                                <ContentControl Margin="6,0,0,0"
                                                                Visibility="{Binding HasInverted, Converter={StaticResource TrueToVisibility}}">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                                                            <Setter Property="Tag" Value="ng"/>
                                                        </Style>
                                                    </ContentControl.Style>
                                                    <TextBlock Text="{Binding InvertedCount}" FontSize="9.5"/>
                                                </ContentControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="照片" Width="76"
                                                HeaderContainerStyle="{StaticResource Grid.Header}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,0,0,0" VerticalAlignment="Center">
                                                <!-- 0 张显示破折号，>0 显示绿色计数徽标；两者互斥，同位置叠放 -->
                                                <TextBlock Text="—" Foreground="{DynamicResource Brush.Faint}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource T.Tiny}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPhoto}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ContentControl>
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                                                            <Setter Property="Tag" Value="ok"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPhoto}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                    <TextBlock Text="{Binding PhotoCount}" FontSize="9.5"/>
                                                </ContentControl>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="装配责任人" Width="180"
                                                HeaderContainerStyle="{StaticResource Grid.Header}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AssemblyOwnersDisplay}"
                                                       Margin="10,0,0,0" FontSize="11.5"
                                                       Foreground="{DynamicResource Brush.Muted}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding AssemblyOwners}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="2" Style="{StaticResource Hairline}" Margin="18,10,18,0"/>
                    <Grid Grid.Row="2" Margin="18,10,18,12">
                        <TextBlock Style="{StaticResource T.Tiny}" FontSize="10.5" VerticalAlignment="Center">
                            <Run Text="{Binding MachineCount, Mode=OneWay}"/><Run Text=" 台 · "/>
                            <Run Text="{Binding IssueCount, Mode=OneWay}"/><Run Text=" 条问题"/>
                        </TextBlock>
                        <TextBlock Text="{Binding PhotoNote}" Style="{StaticResource T.Tiny}" FontSize="10.5"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== 右：选中设备的问题点 ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题条：机台号 + 条数 + 倒挂 -->
                    <Grid Grid.Row="0" Margin="16,13,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◉" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Primary}" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding SelectedTitle}" FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Fg}" VerticalAlignment="Center"/>
                            <ContentControl Style="{StaticResource Chip}" Tag="on" Margin="8,0,0,0">
                                <TextBlock Text="{Binding SelectedIssueCountText}" FontSize="9.5"/>
                            </ContentControl>
                        </StackPanel>
                        <ContentControl Style="{StaticResource Chip}" Tag="ng"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding SelectedHasInverted, Converter={StaticResource TrueToVisibility}}">
                            <TextBlock Text="{Binding SelectedInvertedText}" FontSize="9.5"/>
                        </ContentControl>
                    </Grid>

                    <!-- 责任人 / 照片摘要条 -->
                    <Border Grid.Row="1" Background="{DynamicResource Brush.CardWell}"
                            Padding="16,7" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="装配责任人" Style="{StaticResource T.Tiny}" FontSize="9.5"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedOwnerValue}" FontSize="10.5"
                                           FontWeight="SemiBold" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedPhotoText}" Style="{StaticResource T.Tiny}"
                                       FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 问题点列表（可滚动） -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,9,10,9">
                            <ItemsControl ItemsSource="{Binding SelectedIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,7" Padding="10,8" CornerRadius="8"
                                                Background="{DynamicResource Brush.Panel}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1" Cursor="Hand">
                                            <StackPanel>
                                                <!-- 第一行：序号 + 状态/倒挂徽标 + 责任人 -->
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SeqNo, StringFormat=第 {0} 项}"
                                                                   FontFamily="{DynamicResource Font.Mono}"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource Brush.Muted}"
                                                                   VerticalAlignment="Center"/>
                                                        <ContentControl Style="{StaticResource Chip}" Tag="ng"
                                                                        Margin="6,0,0,0"
                                                                        Visibility="{Binding IsInverted, Converter={StaticResource TrueToVisibility}}">
                                                            <TextBlock Text="{Binding InvertedText}" FontSize="9"/>
                                                        </ContentControl>
                                                        <ContentControl Style="{StaticResource Chip}" Tag="ok"
                                                                        Margin="5,0,0,0"
                                                                        Visibility="{Binding HasPhoto, Converter={StaticResource TrueToVisibility}}">
                                                            <TextBlock Text="{Binding PhotoText}" FontSize="9"/>
                                                        </ContentControl>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding AssemblyOwner}" FontSize="9"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.Muted}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                                </Grid>

                                                <!-- 问题标题 -->
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.Fg}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                                                <!-- 解决措施 -->
                                                <TextBlock Text="{Binding Solution, StringFormat=解决措施：{0}}"
                                                           FontSize="9.5" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource Brush.Muted}"
                                                           TextWrapping="Wrap" MaxHeight="30"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- 设计/装配计划 -->
                                                <Grid Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding DesignPlanLine}" FontSize="9"
                                                               Foreground="{DynamicResource Brush.Muted}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Button Content="打开 →" Style="{StaticResource Btn.Ghost}"
                                                            Height="22" FontSize="9.5" Padding="8,0"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.OpenIssueCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 空状态：这台设备没问题 / 没选设备 -->
                            <Border Padding="14,20" CornerRadius="8"
                                    Visibility="{Binding SelectedHasIssues, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedEmptyHint}" Style="{StaticResource T.Tiny}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </Border>

                            <!-- 照片条（演示占位） -->
                            <StackPanel Margin="0,6,0,0"
                                        Visibility="{Binding SelectedHasPhotos, Converter={StaticResource TrueToVisibility}}">
                                <Grid Margin="2,0,2,6">
                                    <TextBlock Text="现场照片" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Muted}"/>
                                    <TextBlock Text="演示占位 · 历史 Excel 无附件"
                                               FontSize="9" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource Brush.Faint}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SelectedPhotos}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="104" Height="78" Margin="0,0,6,6" CornerRadius="7"
                                                    Background="{DynamicResource Brush.CardWell}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="▣" FontSize="20"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.Faint}"/>
                                                    <ContentControl Style="{StaticResource Chip}" Tag="plain"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top" Margin="3"
                                                                    MinHeight="15" Padding="5,0">
                                                        <TextBlock Text="{Binding Index}" FontSize="8"
                                                                   FontFamily="{DynamicResource Font.Mono}"/>
                                                    </ContentControl>
                                                    <TextBlock Text="{Binding SeqLabel}" FontSize="8"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Bottom" Margin="5,0,0,4"
                                                               Foreground="{DynamicResource Brush.Muted}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部条 -->
                    <Grid Grid.Row="3" Margin="16,8,16,11">
                        <TextBlock Text="点左侧设备切换" Style="{StaticResource T.Tiny}" FontSize="9.5"
                                   VerticalAlignment="Center"/>
                        <Button Content="在台账中筛选 →" Style="{StaticResource Btn.Ghost}" Height="26"
                                FontSize="10.5" Padding="10,0" HorizontalAlignment="Right"
                                Command="{Binding OpenIssuesCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
